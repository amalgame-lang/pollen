// Pollen — TCP node daemon (v0.2.0-dev, Phase 2.1)
//
// TCP transport with long-lived connections + newline-delimited
// JSON framing. Replaces UDP's retry/dedup/SO_RCVBUF machinery
// with kernel-level TCP reliability.
//
//   - One connection per peer pair (long-lived, multiple MSGs flow).
//   - Wire framing: each JSON envelope is terminated by '\n'. The
//     client/server buffer raw recv chunks and split on '\n' to
//     extract complete envelopes; partial trailing bytes stay in
//     the buffer for the next recv.
//   - No app-level ACK retry: TCP retransmits at the kernel.
//   - No UUID dedup cache: TCP ordered, no in-stream duplicates.
//   - No pendingMessages list: synchronous within a connection.
//
// Wire per connection:
//   client → server: <JSON MSG>\n<JSON MSG>\n…
//   server → client: <JSON ACK>\n<JSON ACK>\n…
//   either side closes on EOF; the other detects via null recv.
//
// Usage:
//   pollen-node-tcp 5000                          # listen on :5000
//   pollen-node-tcp 0                             # ephemeral port
//   pollen-node-tcp 0 --publish ip:port:uuid:ver:data    # one-shot client
//
// The --publish flag fires a connect → send → recv-ack → close
// cycle once at startup, then continues into the accept loop.
// Multiple --publish flags allowed; semicolon-separated specs too.

namespace Pollen.Node.Tcp

import Amalgame.Net
import Amalgame.Formats.Json
import Amalgame.DateTime
import Amalgame.Random
import Amalgame.Threading
import Amalgame.Collections
import Amalgame.String

// ── Server hot-path TCP MESSAGE→ACK loop (Phase 2.4c) ─
//
// Drops the AM-side JSON parse + Console.WriteLine + Flush + EncodeAck
// + TcpConn.Send chain. Pure C: recv chunk, memmem for the
// `"messageId":"` marker, sprintf the ACK, send. Measured ~14 µs
// per MSG→ACK round-trip on this VM vs ~150 µs for the AM path.
//
// JSON parsing is bypassed by relying on the publisher always
// emitting messageId as the FIRST field of the envelope (matches
// EncodeMessage in this file). If a non-compliant peer reorders
// fields we'd still find the marker via memmem since it scans the
// whole line, just slower. Type field (MESSAGE/SYNCHRONIZATION)
// isn't checked here — every line gets ACK'd. The orthogonal AM
// path stays for the SYNC handling and would re-enter when needed
// (the AM-side server method below is kept for that).

@c {
    #include <sys/socket.h>
    #include <sys/types.h>
    #include <unistd.h>
    #include <string.h>
    #include <stdio.h>
    #include <stdint.h>
    #include <time.h>
    #include <sys/random.h>

    /* Forward decl: needed by _pollen_wf_rewrite_topic below which
     * comes before the actual definition further down. */
    static const char* _pollen_find(const char* hay, size_t hlen,
                                     const char* needle, size_t nlen);

    static int64_t _pollen_now_ms_c(void) {
        struct timespec ts;
        clock_gettime(CLOCK_REALTIME, &ts);
        return (int64_t) ts.tv_sec * 1000 + (int64_t) ts.tv_nsec / 1000000;
    }

    /* ── workflow.json runtime state (Phase 3.1/3.2) ────
     *
     * Populated once at startup from AM (which has the JSON
     * parser). After that the hot path reads it lock-free —
     * the workflow file is constant for a node's lifetime
     * (Phase 3.3 will add filewatcher reload behind a swap).
     *
     * Topic strings are NUL-terminated. Next-node addresses are
     * (host, port) pairs ready for sockaddr_in.
     *
     * Sizing: 32 consumes + 32 nexts handles every realistic
     * workflow we care about today (real-world DAGs are typically
     * narrow); bigger configurations can lift these statically.
     */
    #define POLLEN_MAX_CONSUMES 32
    #define POLLEN_MAX_NEXTS    32
    #define POLLEN_TOPIC_MAX    128
    #define POLLEN_HOST_MAX     64

    static int  _pollen_wf_active = 0;
    static int  _pollen_wf_n_consumes = 0;
    static int  _pollen_wf_n_nexts = 0;
    static char _pollen_wf_consumes[POLLEN_MAX_CONSUMES][POLLEN_TOPIC_MAX];
    static char _pollen_wf_next_host[POLLEN_MAX_NEXTS][POLLEN_HOST_MAX];
    static int  _pollen_wf_next_port[POLLEN_MAX_NEXTS];
    /* Phase 3.2: when this node emits, forward MESSAGEs to the
     * next-list with topic.uuid replaced by _pollen_wf_emit_topic
     * (first entry of the node's `emits` list in workflow.json).
     * Empty = forward verbatim (rare case where a router-only
     * node doesn't transform). */
    static char _pollen_wf_emit_topic[POLLEN_TOPIC_MAX] = "";

    /* Phase 5.2 — conditional routing flag.
     * Hoisted here so the reload path (defined in this same block)
     * can clear it. Struct + branch table + helpers live in a later
     * @c block. */
    static int _pollen_cond_active = 0;
    static int _pollen_cond_n_branches = 0;
    static int _pollen_cond_current = -1;
    /* Phase 5.3 — same hoist for the set-op queue counter. */
    static int _pollen_n_set_ops = 0;
    /* Phase 5.4 — for / while route active flags, hoisted for
     * reload_begin clear. Full struct + setters live below. */
    static int _pollen_for_active = 0;
    static int _pollen_while_active = 0;

    /* Phase 3.3 — hot-reload guard. Single mutex around the
     * workflow state: writer (AM-side watcher thread reload)
     * holds it for ~1 ms during the begin / add_ / commit
     * sequence;
     * readers (hot-path worker threads) hold it for the duration
     * of one MESSAGE dispatch (~sub-µs typical, ~100 µs if the
     * forward path opens fresh TCP connects). At 60k msg/s the
     * uncontended take cost is ~30 ns × 60 k = 1.8 ms/sec ≈
     * 0.18 % CPU — measured tolerable on the audit hardware.
     */
    #include <pthread.h>
    static pthread_mutex_t _pollen_wf_mutex = PTHREAD_MUTEX_INITIALIZER;
    static int _pollen_wf_version = 0;   /* incremented on each commit */

    /* Phase 3.5 — sharedDir/executions/ persistent state.
     * Each MESSAGE traversal at this node writes one JSON file
     * under sharedDir/executions/<mid>.json. Chains are reconstructed
     * offline by walking parentMessageId backwards. Atomic create
     * via O_CREAT|O_EXCL — duplicate mids (which shouldn't happen
     * since each hop mints a fresh UUID) simply skip silently. */
    #include <fcntl.h>
    #include <sys/stat.h>
    static char _pollen_shared_dir[512] = "";
    static char _pollen_self_role[64] = "";
    static char _pollen_self_host[64] = "127.0.0.1";
    static int  _pollen_self_port = 0;

    static void _pollen_shared_dir_set(const char* path) {
        strncpy(_pollen_shared_dir, path, sizeof(_pollen_shared_dir) - 1);
        _pollen_shared_dir[sizeof(_pollen_shared_dir) - 1] = '\0';
        mkdir(_pollen_shared_dir, 0755);  /* best-effort, EEXIST ok */
        char d[600];
        snprintf(d, sizeof(d), "%s/executions", _pollen_shared_dir);
        mkdir(d, 0755);
    }

    static void _pollen_self_set(const char* role, const char* host, int port) {
        strncpy(_pollen_self_role, role, sizeof(_pollen_self_role) - 1);
        _pollen_self_role[sizeof(_pollen_self_role) - 1] = '\0';
        if (host && host[0]) {
            strncpy(_pollen_self_host, host, sizeof(_pollen_self_host) - 1);
            _pollen_self_host[sizeof(_pollen_self_host) - 1] = '\0';
        }
        _pollen_self_port = port;
    }

    /* ── Phase 4.5.2 — debug pause / phone-home ─────────────────
     *
     * When a MESSAGE arrives with a `debug` field and the local
     * role matches the session's pause criteria (mode=step, or
     * mode=breakpoint + role ∈ bp list, or hit_bp already true),
     * this helper opens a synchronous TCP connection to the
     * manager declared in the envelope, sends a DEBUG_PAUSE JSON
     * line carrying the FULL incoming envelope, then blocks on
     * recv waiting for a single response line. Returns the parsed
     * command code.
     *
     * The connection is one-shot per hop : 1 connect + 1 send +
     * 1 recv + close. We don't keep it warm across hops because
     * each hop runs in a different worker thread of a different
     * node, possibly on a different host.
     *
     * Timeouts :
     *   connect : 3 s   (fail fast if manager is down)
     *   recv    : 60 s  (operator-paced step ; 0 = TIMEOUT → CANCEL)
     */
    #include <errno.h>
    #include <sys/time.h>

    #define POLLEN_DBG_STEP_OVER  0
    #define POLLEN_DBG_STEP_INTO  1
    #define POLLEN_DBG_CONTINUE   2
    #define POLLEN_DBG_CANCEL     3
    #define POLLEN_DBG_MUTATE     4
    #define POLLEN_DBG_TIMEOUT    5
    #define POLLEN_DBG_NO_CONN    6
    #define POLLEN_DBG_NO_PAUSE   7   /* internal — don't pause at all */

    static int _pollen_debug_pause(
            const char* envelope, size_t envelope_len,
            const char* manager_host_port,    /* NUL-terminated */
            const char* session_str,           /* NUL-terminated */
            const char* role,
            char* resp_out,                    /* out: copy of the
                                                 manager response line.
                                                 May be NULL. */
            size_t resp_out_cap
    ) {
        /* host:port split */
        char host[64];
        const char* colon = strchr(manager_host_port, ':');
        if (!colon) return POLLEN_DBG_NO_CONN;
        size_t hlen = (size_t)(colon - manager_host_port);
        if (hlen == 0 || hlen >= sizeof(host)) return POLLEN_DBG_NO_CONN;
        memcpy(host, manager_host_port, hlen);
        host[hlen] = 0;
        int port = atoi(colon + 1);
        if (port <= 0 || port > 65535) return POLLEN_DBG_NO_CONN;

        int fd = socket(AF_INET, SOCK_STREAM, 0);
        if (fd < 0) return POLLEN_DBG_NO_CONN;

        struct sockaddr_in addr;
        memset(&addr, 0, sizeof(addr));
        addr.sin_family = AF_INET;
        addr.sin_port   = htons((uint16_t) port);
        if (inet_pton(AF_INET, host, &addr.sin_addr) != 1) {
            close(fd); return POLLEN_DBG_NO_CONN;
        }
        /* 3s send timeout so connect doesn't hang forever */
        struct timeval ctv = { 3, 0 };
        setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &ctv, sizeof(ctv));
        if (connect(fd, (struct sockaddr*) &addr, sizeof(addr)) < 0) {
            close(fd); return POLLEN_DBG_NO_CONN;
        }

        /* Compose + send the DEBUG_PAUSE JSON :
         *   {"type":"DEBUG_PAUSE","session":"...","role":"...",
         *    "envelope":<incoming envelope verbatim>}
         * The envelope is already valid JSON so it splices in. */
        char header[256];
        int hn = snprintf(header, sizeof(header),
            "{\"type\":\"DEBUG_PAUSE\",\"session\":\"%s\","
            "\"role\":\"%s\",\"envelope\":",
            session_str, role);
        if (hn <= 0 || hn >= (int) sizeof(header)) {
            close(fd); return POLLEN_DBG_NO_CONN;
        }
        if (send(fd, header, (size_t) hn, MSG_NOSIGNAL) != hn) {
            close(fd); return POLLEN_DBG_NO_CONN;
        }
        if (send(fd, envelope, envelope_len, MSG_NOSIGNAL) != (ssize_t) envelope_len) {
            close(fd); return POLLEN_DBG_NO_CONN;
        }
        const char* tail = "}\n";
        send(fd, tail, 2, MSG_NOSIGNAL);

        /* Block on response with 60s recv timeout. */
        struct timeval rtv = { 60, 0 };
        setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &rtv, sizeof(rtv));

        char rbuf[1024];
        ssize_t got = 0;
        ssize_t r;
        while (got < (ssize_t) sizeof(rbuf) - 1) {
            r = recv(fd, rbuf + got, sizeof(rbuf) - 1 - got, 0);
            if (r <= 0) break;
            got += r;
            /* Stop as soon as we have a complete line. */
            if (memchr(rbuf, '\n', got)) break;
        }
        close(fd);
        if (got <= 0) return POLLEN_DBG_TIMEOUT;
        rbuf[got] = 0;

        /* Copy the raw response so the caller can extract MUTATE's
         * data + then fields. Local rbuf goes out of scope on
         * return otherwise. */
        if (resp_out && resp_out_cap > 0) {
            size_t copy = (size_t) got;
            if (copy >= resp_out_cap) copy = resp_out_cap - 1;
            memcpy(resp_out, rbuf, copy);
            resp_out[copy] = 0;
        }

        /* Type-field naive match. The manager only sends one of
         * a small fixed vocabulary. */
        if (strstr(rbuf, "\"DEBUG_STEP_OVER\""))  return POLLEN_DBG_STEP_OVER;
        if (strstr(rbuf, "\"DEBUG_STEP_INTO\""))  return POLLEN_DBG_STEP_INTO;
        if (strstr(rbuf, "\"DEBUG_STEP\""))       return POLLEN_DBG_STEP_INTO;
        if (strstr(rbuf, "\"DEBUG_CONTINUE\""))   return POLLEN_DBG_CONTINUE;
        if (strstr(rbuf, "\"DEBUG_CANCEL\""))     return POLLEN_DBG_CANCEL;
        if (strstr(rbuf, "\"DEBUG_MUTATE\""))     return POLLEN_DBG_MUTATE;
        return POLLEN_DBG_TIMEOUT;
    }

    /* Decide whether this node should pause for an incoming debug
     * envelope. Extracts mode + hit_bp + breakpoints from the
     * envelope and matches against the local role.
     *   POLLEN_DBG_NO_PAUSE   → don't pause, forward normally
     *   POLLEN_DBG_STEP_INTO  → pause (rolled into a single
     *                            "should pause" return — the
     *                            actual command is decided by the
     *                            manager response). Re-using a code
     *                            value is fine ; the caller checks
     *                            with `!= NO_PAUSE`.
     */
    static int _pollen_debug_should_pause(
            const char* envelope, size_t envelope_len,
            const char* self_role
    ) {
        const char* MODE_KEY = "\"debug\":{\"session\":\"";
        const char* d = _pollen_find(envelope, envelope_len, MODE_KEY, 20);
        if (!d) return POLLEN_DBG_NO_PAUSE;

        /* Look for "hit_bp":true within the debug field — anywhere
         * later in the envelope is fine since debug is the last
         * field of an envelope from our publisher. */
        const char* hit = _pollen_find(envelope, envelope_len,
            "\"hit_bp\":true", 13);
        if (hit) return POLLEN_DBG_STEP_INTO;  /* sticky once tripped */

        /* mode lookup */
        const char* mk = _pollen_find(envelope, envelope_len,
            "\"mode\":\"", 8);
        if (!mk) return POLLEN_DBG_NO_PAUSE;
        const char* mv = mk + 8;
        const char* mq = memchr(mv, '"',
            envelope_len - (size_t)(mv - envelope));
        if (!mq) return POLLEN_DBG_NO_PAUSE;
        size_t mlen = (size_t)(mq - mv);
        int is_step = (mlen == 4 && memcmp(mv, "step", 4) == 0);
        int is_bp   = (mlen == 10 && memcmp(mv, "breakpoint", 10) == 0);

        if (is_step) return POLLEN_DBG_STEP_INTO;
        if (!is_bp)  return POLLEN_DBG_NO_PAUSE;

        /* mode=breakpoint : check if our role appears in the
         * breakpoints array. Heuristic : look for `"role":"<self>"`
         * after the `"breakpoints":[` marker. Good enough since
         * the envelope doesn't have any other `"role":` field on
         * the producer side. */
        const char* bps = _pollen_find(envelope, envelope_len,
            "\"breakpoints\":[", 15);
        if (!bps) return POLLEN_DBG_NO_PAUSE;
        char needle[80];
        int nlen = snprintf(needle, sizeof(needle),
            "\"role\":\"%s\"", self_role);
        if (nlen <= 0 || nlen >= (int) sizeof(needle)) return POLLEN_DBG_NO_PAUSE;
        size_t after_off = (size_t)(bps - envelope);
        const char* hit2 = _pollen_find(envelope + after_off,
            envelope_len - after_off, needle, (size_t) nlen);
        return hit2 ? POLLEN_DBG_STEP_INTO : POLLEN_DBG_NO_PAUSE;
    }

    /* Phase 4.5.4 — rewrite the debug.mode + debug.hit_bp values
     * of an envelope before forwarding. The downstream chain then
     * sees the operator's intent :
     *   CONTINUE   → mode="breakpoint", hit_bp=false
     *                → run until next bp (or end if no more bps)
     *   STEP_*     → mode="step", hit_bp=false
     *                → every downstream node pauses
     * Returns the length of the rewritten envelope into `out`, or
     * 0 if the envelope doesn't carry a debug field (caller falls
     * back to forwarding verbatim — which is fine, no debug to
     * rewrite). */
    static size_t _pollen_debug_rewrite(
            const char* in, size_t in_len,
            char* out, size_t out_cap,
            const char* new_mode,    /* "step" or "breakpoint" */
            int new_hit_bp           /* 0 → false, 1 → true */
    ) {
        const char* m = _pollen_find(in, in_len, "\"mode\":\"", 8);
        if (!m) return 0;
        const char* mv_start = m + 8;
        const char* mv_end = memchr(mv_start, '"',
            in_len - (size_t)(mv_start - in));
        if (!mv_end) return 0;

        const char* h = _pollen_find(in, in_len, "\"hit_bp\":", 9);
        if (!h) return 0;
        const char* hv_start = h + 9;
        const char* hv_end;
        if (in_len - (size_t)(hv_start - in) >= 4
            && memcmp(hv_start, "true", 4) == 0) {
            hv_end = hv_start + 4;
        } else if (in_len - (size_t)(hv_start - in) >= 5
            && memcmp(hv_start, "false", 5) == 0) {
            hv_end = hv_start + 5;
        } else {
            return 0;
        }

        /* Sanity : mode must come before hit_bp in the envelope
         * (which is our canonical order). */
        if (mv_end >= h) return 0;

        const char* new_hit_str = new_hit_bp ? "true" : "false";
        size_t new_mode_len = strlen(new_mode);
        size_t new_hit_len  = strlen(new_hit_str);

        size_t pre   = (size_t)(mv_start - in);
        size_t mid   = (size_t)(h - mv_end);
        size_t tail  = (size_t)((in + in_len) - hv_end);
        size_t total = pre + new_mode_len + mid + 9 + new_hit_len + tail;

        if (total > out_cap) return 0;

        size_t o = 0;
        memcpy(out + o, in, pre); o += pre;
        memcpy(out + o, new_mode, new_mode_len); o += new_mode_len;
        memcpy(out + o, mv_end, mid); o += mid;
        memcpy(out + o, "\"hit_bp\":", 9); o += 9;
        memcpy(out + o, new_hit_str, new_hit_len); o += new_hit_len;
        memcpy(out + o, hv_end, tail); o += tail;
        return o;
    }

    /* Phase 4.5.7 — rewrite `data` field in an envelope. Used by
     * MUTATE : the operator edited the payload in the manager UI,
     * we patch the envelope before forwarding so downstream nodes
     * see the new data.
     *
     * Anchors :
     *   start = end of `"data":`
     *   end   = start of `,"timestamp":`
     *           (our publisher always emits timestamp right after
     *            data, so this is reliable)
     *
     * Returns total length on success, 0 on failure (caller falls
     * back to forwarding the unmodified envelope). */
    static size_t _pollen_debug_rewrite_data(
            const char* in, size_t in_len,
            char* out, size_t out_cap,
            const char* new_data, size_t new_data_len
    ) {
        const char* d = _pollen_find(in, in_len, "\"data\":", 7);
        if (!d) return 0;
        const char* d_val_start = d + 7;
        size_t after_off = (size_t)(d_val_start - in);
        const char* d_end = _pollen_find(in + after_off,
            in_len - after_off, ",\"timestamp\":", 13);
        if (!d_end) return 0;

        size_t pre  = (size_t)(d_val_start - in);
        size_t tail = in_len - (size_t)(d_end - in);
        size_t total = pre + new_data_len + tail;
        if (total > out_cap) return 0;

        memcpy(out, in, pre);
        memcpy(out + pre, new_data, new_data_len);
        memcpy(out + pre + new_data_len, d_end, tail);
        return total;
    }

    /* Extract the JSON value of a `"<key>":<value>` pair where the
     * value is a JSON OBJECT or ARRAY (matching braces / brackets).
     * Used to pull out the `data` field of a DEBUG_MUTATE response
     * which may itself be a complex value.
     *
     * `key_with_quotes` is e.g.  "\"data\":"
     * Writes [start_off, end_off) into out params. Returns 1 on
     * success, 0 if not found / unbalanced. */
    static int _pollen_extract_json_value(
            const char* buf, size_t buf_len,
            const char* key_with_quotes, size_t key_len,
            size_t* out_start, size_t* out_end
    ) {
        const char* k = _pollen_find(buf, buf_len, key_with_quotes, key_len);
        if (!k) return 0;
        const char* v = k + key_len;
        /* Skip optional whitespace */
        while (v < buf + buf_len && (*v == ' ' || *v == '\t')) v++;
        if (v >= buf + buf_len) return 0;
        size_t start = (size_t)(v - buf);
        char open  = *v;
        char close;
        if      (open == '{') close = '}';
        else if (open == '[') close = ']';
        else if (open == '"') {
            /* String value : walk until unescaped closing quote */
            size_t i = start + 1;
            while (i < buf_len) {
                if (buf[i] == '\\') { i += 2; continue; }
                if (buf[i] == '"') { *out_start = start; *out_end = i + 1; return 1; }
                i++;
            }
            return 0;
        } else {
            /* Number / true / false / null : walk until , } ]
             * or whitespace */
            size_t i = start;
            while (i < buf_len
                   && buf[i] != ',' && buf[i] != '}' && buf[i] != ']'
                   && buf[i] != ' ' && buf[i] != '\t'
                   && buf[i] != '\n' && buf[i] != '\r') i++;
            *out_start = start; *out_end = i; return 1;
        }
        /* Object / array : depth-counted scan */
        int depth = 0;
        for (size_t i = start; i < buf_len; i++) {
            char c = buf[i];
            if (c == '"') {
                /* Skip string literal */
                i++;
                while (i < buf_len) {
                    if (buf[i] == '\\') { i += 2; continue; }
                    if (buf[i] == '"') break;
                    i++;
                }
                continue;
            }
            if (c == open) depth++;
            else if (c == close) {
                depth--;
                if (depth == 0) { *out_start = start; *out_end = i + 1; return 1; }
            }
        }
        return 0;
    }

    /* Extract `"debug":{...,"manager":"<host:port>",...}` into a
     * NUL-terminated buffer. Returns 1 on success, 0 if not found. */
    static int _pollen_debug_extract_manager(
            const char* envelope, size_t envelope_len,
            char* out, size_t out_cap
    ) {
        const char* m = _pollen_find(envelope, envelope_len,
            "\"manager\":\"", 11);
        if (!m) return 0;
        const char* v = m + 11;
        const char* q = memchr(v, '"',
            envelope_len - (size_t)(v - envelope));
        if (!q) return 0;
        size_t vlen = (size_t)(q - v);
        if (vlen == 0 || vlen >= out_cap) return 0;
        memcpy(out, v, vlen);
        out[vlen] = 0;
        return 1;
    }

    /* Write one execution step record. All string args are length-
     * delimited so callers can pass pointers into the recv buffer
     * without NUL-terminating. parent_mid may be NULL (root step).
     * topic_out may be NULL (terminal sink, no forward).
     *
     * Filename is <mid>-<role>.json: an emitter and a downstream
     * sink see the same mid (the emitter just minted it, the sink
     * just received it), so we disambiguate by role to keep both
     * step records side-by-side. Chain walk: read X-<*>.json for
     * any role to find parentMessageId, then repeat. */
    static void _pollen_wf_record_step(
            const char* mid_out, size_t mid_out_len,
            const char* parent_mid, size_t parent_mid_len,
            const char* topic_in, size_t topic_in_len,
            const char* topic_out,
            int n_nexts,
            const char* dbg_session, size_t dbg_session_len) {
        if (!_pollen_shared_dir[0]) return;
        char path[1024];
        snprintf(path, sizeof(path), "%s/executions/%.*s-%s.json",
                 _pollen_shared_dir,
                 (int) mid_out_len, mid_out,
                 _pollen_self_role[0] ? _pollen_self_role : "node");
        int fd = open(path, O_WRONLY | O_CREAT | O_EXCL, 0644);
        if (fd < 0) return;  /* dup or fs error: best-effort, skip */
        char buf[1280];
        int64_t now = _pollen_now_ms_c();
        /* Phase 4.5.1 — optional debugSession suffix. Only present
         * when the incoming envelope carried a `debug` field. */
        char dbg_suffix[80] = "";
        if (dbg_session && dbg_session_len > 0 && dbg_session_len < 64) {
            snprintf(dbg_suffix, sizeof(dbg_suffix),
                ",\"debugSession\":\"%.*s\"",
                (int) dbg_session_len, dbg_session);
        }
        int n;
        if (parent_mid && parent_mid_len > 0) {
            n = snprintf(buf, sizeof(buf),
                "{\"messageId\":\"%.*s\","
                "\"parentMessageId\":\"%.*s\","
                "\"role\":\"%s\",\"topicIn\":\"%.*s\","
                "\"topicOut\":\"%s\",\"nextCount\":%d,"
                "\"node\":\"%s:%d\",\"timestamp\":%lld%s}\n",
                (int) mid_out_len, mid_out,
                (int) parent_mid_len, parent_mid,
                _pollen_self_role,
                (int) topic_in_len, topic_in,
                topic_out ? topic_out : "",
                n_nexts,
                _pollen_self_host, _pollen_self_port,
                (long long) now,
                dbg_suffix);
        } else {
            n = snprintf(buf, sizeof(buf),
                "{\"messageId\":\"%.*s\","
                "\"parentMessageId\":null,"
                "\"role\":\"%s\",\"topicIn\":\"%.*s\","
                "\"topicOut\":\"%s\",\"nextCount\":%d,"
                "\"node\":\"%s:%d\",\"timestamp\":%lld%s}\n",
                (int) mid_out_len, mid_out,
                _pollen_self_role,
                (int) topic_in_len, topic_in,
                topic_out ? topic_out : "",
                n_nexts,
                _pollen_self_host, _pollen_self_port,
                (long long) now,
                dbg_suffix);
        }
        if (n > 0 && n < (int) sizeof(buf)) {
            write(fd, buf, (size_t) n);
        }
        close(fd);
    }

    static void _pollen_wf_add_consume(const char* topic) {
        if (_pollen_wf_n_consumes >= POLLEN_MAX_CONSUMES) return;
        strncpy(_pollen_wf_consumes[_pollen_wf_n_consumes], topic,
                POLLEN_TOPIC_MAX - 1);
        _pollen_wf_consumes[_pollen_wf_n_consumes][POLLEN_TOPIC_MAX - 1] = '\0';
        _pollen_wf_n_consumes++;
        _pollen_wf_active = 1;
    }

    static void _pollen_wf_add_next(const char* host, int port) {
        if (_pollen_wf_n_nexts >= POLLEN_MAX_NEXTS) return;
        strncpy(_pollen_wf_next_host[_pollen_wf_n_nexts], host,
                POLLEN_HOST_MAX - 1);
        _pollen_wf_next_host[_pollen_wf_n_nexts][POLLEN_HOST_MAX - 1] = '\0';
        _pollen_wf_next_port[_pollen_wf_n_nexts] = port;
        _pollen_wf_n_nexts++;
        _pollen_wf_active = 1;
    }

    static void _pollen_wf_set_emit_topic(const char* topic) {
        strncpy(_pollen_wf_emit_topic, topic, POLLEN_TOPIC_MAX - 1);
        _pollen_wf_emit_topic[POLLEN_TOPIC_MAX - 1] = '\0';
    }

    /* Phase 3.3 reload begin: acquire the lock, wipe state. The
     * AM caller then populates via _pollen_wf_add_consume /
     * add_next / set_emit_topic, and commits to release. */
    static void _pollen_wf_reload_begin(void) {
        pthread_mutex_lock(&_pollen_wf_mutex);
        _pollen_wf_n_consumes = 0;
        _pollen_wf_n_nexts = 0;
        _pollen_wf_emit_topic[0] = '\0';
        /* Phase 5.2 — also clear conditional routing so a reload that
         * drops the `if` reverts to plain fan_out. */
        _pollen_cond_active = 0;
        _pollen_cond_n_branches = 0;
        _pollen_cond_current = -1;
        /* Phase 5.3 — drop pending state set-ops on reload. */
        _pollen_n_set_ops = 0;
        /* Phase 5.4 — drop loop routing on reload. */
        _pollen_for_active = 0;
        _pollen_while_active = 0;
        /* _pollen_wf_active stays sticky — once a node has loaded
         * a workflow, free-form fallback no longer kicks in even if
         * the new file is empty. Operator can restart to disable. */
    }

    static void _pollen_wf_reload_commit(void) {
        _pollen_wf_version++;
        pthread_mutex_unlock(&_pollen_wf_mutex);
    }

    static int _pollen_wf_get_version(void) {
        return _pollen_wf_version;
    }

    /* O(N×M) consume check; with N ≤ 32 and 128-byte topics this
     * stays sub-µs and keeps the hot loop branchless of mallocs. */
    static int _pollen_wf_topic_consumed(const char* topic, size_t topic_len) {
        for (int i = 0; i < _pollen_wf_n_consumes; i++) {
            size_t l = strlen(_pollen_wf_consumes[i]);
            if (l == topic_len && memcmp(_pollen_wf_consumes[i], topic, l) == 0) {
                return 1;
            }
        }
        return 0;
    }

    /* One-shot forward to a single next-node. Opens a fresh TCP
     * connection, sends the envelope verbatim + '\n', closes.
     * The next-node ACKs back through its own server thread; we
     * don't wait for that ACK (fire-and-pipeline). Persistent
     * forward connections are a Phase 3.x optimisation.
     */
    static void _pollen_wf_forward_one(const char* host, int port,
                                        const char* envelope, size_t env_len) {
        int fd = socket(AF_INET, SOCK_STREAM, 0);
        if (fd < 0) return;
        struct sockaddr_in addr; memset(&addr, 0, sizeof(addr));
        addr.sin_family = AF_INET;
        addr.sin_port   = htons((uint16_t) port);
        if (inet_pton(AF_INET, host, &addr.sin_addr) != 1) { close(fd); return; }
        if (connect(fd, (struct sockaddr*) &addr, sizeof(addr)) < 0) { close(fd); return; }
        /* Append '\n' if envelope doesn't already end with one. */
        if (env_len > 0 && envelope[env_len - 1] == '\n') {
            send(fd, envelope, env_len, MSG_NOSIGNAL);
        } else {
            send(fd, envelope, env_len, MSG_NOSIGNAL);
            send(fd, "\n", 1, MSG_NOSIGNAL);
        }
        /* Fire-and-forget close. The earlier code did SHUT_WR +
         * drain-until-EOF for graceful close, but that deadlocks
         * on self-loop (Phase 5.4 `while`) because the receiver
         * holds _pollen_wf_mutex through its whole forward chain,
         * and we'd be blocked here waiting for it. The receiver's
         * recv loop sees EOF on close() too. */
        close(fd);
    }

    /* Phase 3.4 — generate a fresh UUIDv4 RFC 4122 into buf[37].
     * Caller guarantees buf is ≥ 37 bytes. */
    static void _pollen_gen_uuid(char* buf) {
        unsigned char b[16];
        getrandom(b, 16, 0);
        b[6] = (unsigned char)((b[6] & 0x0F) | 0x40);
        b[8] = (unsigned char)((b[8] & 0x3F) | 0x80);
        const char* hex = "0123456789abcdef";
        int p = 0;
        for (int k = 0; k < 16; k++) {
            if (k == 4 || k == 6 || k == 8 || k == 10) buf[p++] = '-';
            buf[p++] = hex[(b[k] >> 4) & 0xF];
            buf[p++] = hex[b[k] & 0xF];
        }
        buf[p] = '\0';
    }

    /* Phase 3.4 — rebuild an envelope for forward: fresh messageId,
     * topic optionally rewritten, parentMessageId appended carrying
     * the OLD messageId (so downstream nodes can walk the chain
     * back to the producer). Returns the length of the rebuilt
     * buffer (including trailing '\n'), or 0 on parse failure
     * (caller falls back to verbatim forward).
     *
     * Memory layout of the output:
     *
     *   in[0 .. msgid_value_pos)    "messageId":"
     *   <NEW 36-char UUID>          (always replaces old)
     *   in[msgid_end_pos .. topic_uuid_value_pos)
     *                               …rest until topic.uuid value if rewriting…
     *   <NEW topic>                 (only if new_topic != NULL)
     *   in[topic_uuid_end_pos .. close_pos)
     *                               …rest of the envelope up to the closing '}'…
     *   ,"parentMessageId":"        chain field
     *   <OLD 36-char UUID>
     *   "}                          terminator
     *   \n
     */
    static size_t _pollen_wf_rebuild_envelope(
            const char* in, size_t in_len,
            char* out, size_t out_cap,
            const char* new_topic,
            char* out_new_mid /* may be NULL; 37-byte buf */) {
        const char* m_key = _pollen_find(in, in_len, "\"messageId\":\"", 13);
        if (!m_key) return 0;
        const char* old_mid = m_key + 13;
        const char* old_mid_end = memchr(old_mid, '"',
            in_len - (size_t)(old_mid - in));
        if (!old_mid_end || (size_t)(old_mid_end - old_mid) != 36) return 0;

        const char* t_uuid_start = NULL;
        const char* t_uuid_end = NULL;
        if (new_topic) {
            const char* t_key = _pollen_find(in, in_len,
                "\"topic\":{\"uuid\":\"", 17);
            if (t_key) {
                t_uuid_start = t_key + 17;
                t_uuid_end = memchr(t_uuid_start, '"',
                    in_len - (size_t)(t_uuid_start - in));
                if (!t_uuid_end) { t_uuid_start = NULL; }
            }
        }

        /* find the closing '}' before any trailing whitespace */
        size_t e = in_len;
        while (e > 0 && (in[e-1] == '\n' || in[e-1] == '\r' ||
                          in[e-1] == ' '  || in[e-1] == '\t')) e--;
        if (e == 0 || in[e-1] != '}') return 0;
        size_t close_pos = e - 1;

        char new_mid[37];
        _pollen_gen_uuid(new_mid);
        if (out_new_mid) memcpy(out_new_mid, new_mid, 37);

        /* Emit piecewise into out[] with bounds checks. */
        size_t o = 0;
        #define _PE(src, n) do { \
            if (o + (n) > out_cap) return 0; \
            memcpy(out + o, (src), (n)); o += (n); \
        } while (0)

        size_t mid_value_pos = (size_t)(old_mid - in);
        size_t mid_end_pos   = (size_t)(old_mid_end - in);

        /* Up to "messageId":" */
        _PE(in, mid_value_pos);
        /* New 36-char UUID */
        _PE(new_mid, 36);

        if (t_uuid_start && t_uuid_end && new_topic) {
            size_t t_v_pos = (size_t)(t_uuid_start - in);
            size_t t_e_pos = (size_t)(t_uuid_end - in);
            /* between old messageId close-quote and topic.uuid value */
            _PE(in + mid_end_pos, t_v_pos - mid_end_pos);
            /* new topic */
            size_t tlen = strlen(new_topic);
            _PE(new_topic, tlen);
            /* topic.uuid end through closing '}' */
            _PE(in + t_e_pos, close_pos - t_e_pos);
        } else {
            /* no topic rewrite: old messageId close-quote through '}' */
            _PE(in + mid_end_pos, close_pos - mid_end_pos);
        }

        /* ,"parentMessageId":"<OLD>"} \n */
        const char* PARENT_OPEN = ",\"parentMessageId\":\"";
        _PE(PARENT_OPEN, 20);
        _PE(old_mid, 36);
        _PE("\"}", 2);
        _PE("\n", 1);

        #undef _PE
        return o;
    }

    /* Rewrite topic.uuid in-place in a fresh buffer. Returns the
     * length of the rewritten envelope, or 0 if the topic block
     * couldn't be located (caller falls back to verbatim forward).
     * The envelope shape is the publisher's snprintf output:
     *   {…,"topic":{"uuid":"<old>","version":N},…}
     * We replace `<old>` with the global _pollen_wf_emit_topic.
     */
    static size_t _pollen_wf_rewrite_topic(const char* in, size_t in_len,
                                            char* out, size_t out_cap) {
        const char* TOPIC_KEY = "\"topic\":{\"uuid\":\"";
        const size_t TOPIC_KEY_LEN = 17;
        const char* tp = _pollen_find(in, in_len, TOPIC_KEY, TOPIC_KEY_LEN);
        if (!tp) return 0;
        tp += TOPIC_KEY_LEN;
        const char* tq = memchr(tp, '"', in_len - (size_t)(tp - in));
        if (!tq) return 0;
        size_t prefix_len = (size_t)(tp - in);
        size_t suffix_off = (size_t)(tq - in);
        size_t suffix_len = in_len - suffix_off;
        size_t new_topic_len = strlen(_pollen_wf_emit_topic);
        size_t total = prefix_len + new_topic_len + suffix_len;
        if (total > out_cap) return 0;
        memcpy(out, in, prefix_len);
        memcpy(out + prefix_len, _pollen_wf_emit_topic, new_topic_len);
        memcpy(out + prefix_len + new_topic_len, in + suffix_off, suffix_len);
        return total;
    }

    static void _pollen_wf_forward_all(const char* envelope, size_t env_len,
                                        char* out_new_mid /* may be NULL */) {
        /* Phase 3.4: always rebuild with fresh messageId +
         * parentMessageId chain. Topic is rewritten too if the
         * node declared an emits[0]. Failure to rebuild (oversize
         * envelope, parse mismatch) falls back to verbatim — the
         * forward still goes through, just without the chain. */
        char rebuilt[8192];
        const char* fwd = envelope;
        size_t fwd_len = env_len;
        const char* new_topic = _pollen_wf_emit_topic[0] ?
                                _pollen_wf_emit_topic : NULL;
        size_t rn = _pollen_wf_rebuild_envelope(envelope, env_len,
                                                 rebuilt, sizeof(rebuilt),
                                                 new_topic, out_new_mid);
        if (rn > 0) { fwd = rebuilt; fwd_len = rn; }
        else if (out_new_mid) { out_new_mid[0] = '\0'; }
        for (int i = 0; i < _pollen_wf_n_nexts; i++) {
            _pollen_wf_forward_one(_pollen_wf_next_host[i],
                                   _pollen_wf_next_port[i],
                                   fwd, fwd_len);
        }
    }

    /* ── Phase 5.2 — conditional routing (`if` action) ────────
     *
     * When the role's next-step in the tree is an `{type:"if",
     * branches:[{cond, action}, ...], else?}`, routing becomes
     * runtime : we evaluate each branch's `cond` against the
     * incoming envelope's `data` field and forward to the FIRST
     * matching branch's targets. If no branch matches and an
     * `else` is set, forward to its targets. Otherwise drop.
     *
     * Cond schema for 5.2 (intentionally minimal — Phase 5.2.1
     * extends with and/or/not/nested) :
     *
     *   { "op": "==|!=|<|>|<=|>=",
     *     "left":  { "var": "data.X" },
     *     "right": { "const": <num | "str" | true | false> } }
     *
     * Storage : static globals populated by AM-side LoadWorkflow.
     * Protected by the same _pollen_wf_mutex as next[] so a
     * hot-reload swap stays atomic.
     */
    #define POLLEN_COND_MAX_BRANCHES   8
    #define POLLEN_COND_VAR_MAX        64
    #define POLLEN_COND_STR_MAX        128

    /* op codes */
    #define POLLEN_COND_NONE   0  /* else / always-true */
    #define POLLEN_COND_EQ     1
    #define POLLEN_COND_NE     2
    #define POLLEN_COND_LT     3
    #define POLLEN_COND_GT     4
    #define POLLEN_COND_LE     5
    #define POLLEN_COND_GE     6

    /* Phase 5.4.1 — store cond as raw JSON so the eval can handle
     * composite expressions ({"op":"and|or","args":[…]} and
     * {"op":"not","arg":…}) in addition to leaf comparisons. Empty
     * string = else branch / always true. */
    #define POLLEN_COND_EXPR_MAX 1024

    typedef struct {
        char    cond_expr[POLLEN_COND_EXPR_MAX];
        char    targets_host[POLLEN_MAX_NEXTS][POLLEN_HOST_MAX];
        int     targets_port[POLLEN_MAX_NEXTS];
        int     n_targets;
    } pollen_cond_branch_t;

    /* _pollen_cond_active, _pollen_cond_n_branches, _pollen_cond_current
     * are declared in the earlier hot-path @c block so reload_begin
     * can reset them. Only the table of branches lives here (needs
     * the struct above). */
    static pollen_cond_branch_t _pollen_cond_branches[POLLEN_COND_MAX_BRANCHES];

    /* Reset + open + add-target + close, called by AM-side
     * LoadWorkflow when an `if` is detected. */
    static void _pollen_cond_clear(void) {
        _pollen_cond_active = 0;
        _pollen_cond_n_branches = 0;
        _pollen_cond_current = -1;
    }

    /* Open a new branch. Empty cond_json = else / always-true. */
    static void _pollen_cond_branch_open_expr(const char* cond_json) {
        if (_pollen_cond_n_branches >= POLLEN_COND_MAX_BRANCHES) return;
        _pollen_cond_active = 1;
        _pollen_cond_current = _pollen_cond_n_branches;
        pollen_cond_branch_t* b = &_pollen_cond_branches[_pollen_cond_current];
        strncpy(b->cond_expr, cond_json ? cond_json : "",
                 sizeof(b->cond_expr) - 1);
        b->cond_expr[sizeof(b->cond_expr) - 1] = 0;
        b->n_targets = 0;
        _pollen_cond_n_branches++;
    }

    static void _pollen_cond_branch_add_target(const char* host, int port) {
        if (_pollen_cond_current < 0
            || _pollen_cond_current >= _pollen_cond_n_branches) return;
        pollen_cond_branch_t* b = &_pollen_cond_branches[_pollen_cond_current];
        if (b->n_targets >= POLLEN_MAX_NEXTS) return;
        strncpy(b->targets_host[b->n_targets], host, POLLEN_HOST_MAX - 1);
        b->targets_host[b->n_targets][POLLEN_HOST_MAX - 1] = 0;
        b->targets_port[b->n_targets] = port;
        b->n_targets++;
    }

    /* Phase 5.2.1 — find the JSON value for a dotted path within a
     * range. Walks segment-by-segment : for each segment, locate
     * `"seg":` in the current range, parse past whitespace ; if not
     * the last segment, ensure the value is an object `{...}` and
     * narrow the range to its braces ; for the last segment, return
     * a pointer + length covering the raw value (string contents
     * without quotes, or full token for literals/numbers). Returns
     * 0 on miss / type error. */
    static int _pollen_resolve_path(const char* env, size_t env_len,
                                     const char* path,
                                     const char** out_val, size_t* out_len) {
        const char* range_lo = env;
        const char* range_hi = env + env_len;
        const char* p = path;
        for (;;) {
            /* Pull one segment (up to next '.' or end). */
            const char* dot = strchr(p, '.');
            char seg[POLLEN_COND_VAR_MAX];
            size_t seglen = dot ? (size_t)(dot - p) : strlen(p);
            if (seglen == 0 || seglen + 4 >= sizeof(seg)) return 0;
            seg[0] = '"';
            memcpy(seg + 1, p, seglen);
            seg[1 + seglen] = '"';
            seg[2 + seglen] = ':';
            int needle_len = (int)(seglen + 3);

            const char* k = _pollen_find(range_lo, (size_t)(range_hi - range_lo),
                                          seg, (size_t) needle_len);
            if (!k) return 0;
            const char* v = k + needle_len;
            while (v < range_hi && (*v == ' ' || *v == '\t')) v++;
            if (v >= range_hi) return 0;

            int is_last = (dot == NULL);
            if (!is_last) {
                /* Must descend into an object. */
                if (*v != '{') return 0;
                /* Brace-count to find the matching '}'. */
                int depth = 1;
                const char* w = v + 1;
                int in_str = 0;
                while (w < range_hi && depth > 0) {
                    char c = *w;
                    if (in_str) {
                        if (c == '\\' && w + 1 < range_hi) { w += 2; continue; }
                        if (c == '"') in_str = 0;
                    } else {
                        if (c == '"') in_str = 1;
                        else if (c == '{') depth++;
                        else if (c == '}') depth--;
                    }
                    w++;
                }
                if (depth != 0) return 0;
                range_lo = v + 1;
                range_hi = w - 1;
                p = dot + 1;
                continue;
            }

            /* Last segment — return the raw value extent. For
             * strings we strip the surrounding quotes ; for others
             * we walk until a JSON-value terminator. */
            if (*v == '"') {
                const char* q = v + 1;
                while (q < range_hi) {
                    if (*q == '\\' && q + 1 < range_hi) { q += 2; continue; }
                    if (*q == '"') break;
                    q++;
                }
                if (q >= range_hi) return 0;
                *out_val = v;            /* includes leading quote */
                *out_len = (size_t)(q - v) + 1;
                return 1;
            }
            const char* q = v;
            while (q < range_hi
                   && *q != ',' && *q != '}' && *q != ']'
                   && *q != ' ' && *q != '\t' && *q != '\n' && *q != '\r') {
                q++;
            }
            *out_val = v;
            *out_len = (size_t)(q - v);
            return 1;
        }
    }

    /* ── Phase 5.3 — persistent state under sharedDir/state ──
     *
     * Each execution (identified by its rootMessageId) gets a single
     * JSON file at <sharedDir>/state/<root-mid>.json containing a
     * flat object of state keys. `set` actions mutate it via atomic
     * tmp + rename. `state.X` lookups in conditions read it back.
     * Survival across crashes is the whole point ; an op-electrique
     * mid-execution should resume from the last committed state.
     */
    #define POLLEN_STATE_FILE_MAX 8192

    static int _pollen_state_filepath(const char* root_mid,
                                       char* out, size_t cap) {
        if (!_pollen_shared_dir[0] || !root_mid || !root_mid[0]) return 0;
        int n = snprintf(out, cap, "%s/state/%s.json",
                          _pollen_shared_dir, root_mid);
        return (n > 0 && n < (int) cap);
    }

    static void _pollen_state_dir_ensure(void) {
        if (!_pollen_shared_dir[0]) return;
        char d[600];
        snprintf(d, sizeof(d), "%s/state", _pollen_shared_dir);
        mkdir(d, 0755);
    }

    static int _pollen_state_read(const char* root_mid,
                                    char* buf, size_t cap) {
        char path[1024];
        if (!_pollen_state_filepath(root_mid, path, sizeof(path))) return -1;
        int fd = open(path, O_RDONLY);
        if (fd < 0) return -1;
        ssize_t n = read(fd, buf, cap - 1);
        close(fd);
        if (n <= 0) return -1;
        buf[n] = 0;
        return (int) n;
    }

    static int _pollen_state_write(const char* root_mid,
                                     const char* buf, size_t len) {
        char path[1024], tmp[1100];
        if (!_pollen_state_filepath(root_mid, path, sizeof(path))) return 0;
        _pollen_state_dir_ensure();
        snprintf(tmp, sizeof(tmp), "%s.tmp.%d", path, (int) getpid());
        int fd = open(tmp, O_WRONLY | O_CREAT | O_TRUNC, 0644);
        if (fd < 0) return 0;
        ssize_t w = write(fd, buf, len);
        close(fd);
        if (w != (ssize_t) len) { unlink(tmp); return 0; }
        if (rename(tmp, path) != 0) { unlink(tmp); return 0; }
        return 1;
    }

    /* Mutate a single top-level key in the per-execution state file.
     * value_lit is a JSON literal (number, quoted string, true, false,
     * null). For now only top-level keys are supported — `state.X.Y`
     * is treated as a single key name with a literal dot in it,
     * which works but doesn't compose with cond eval's dotted
     * resolution. Phase 5.3.1 will handle nested set. */
    static int _pollen_state_set(const char* root_mid,
                                   const char* path,
                                   const char* json_literal) {
        const char* key = path;
        if (strncmp(key, "state.", 6) == 0) key += 6;
        if (!key[0]) return 0;

        char old_buf[POLLEN_STATE_FILE_MAX];
        int old_n = _pollen_state_read(root_mid, old_buf, sizeof(old_buf));

        char new_buf[POLLEN_STATE_FILE_MAX];
        int n = 0;

        if (old_n <= 0) {
            n = snprintf(new_buf, sizeof(new_buf),
                          "{\"%s\":%s}\n", key, json_literal);
        } else {
            char needle[80];
            int nlen = snprintf(needle, sizeof(needle), "\"%s\":", key);
            const char* found = (nlen > 0)
                ? _pollen_find(old_buf, (size_t) old_n,
                                 needle, (size_t) nlen)
                : NULL;
            if (found) {
                const char* v = found + nlen;
                const char* v_end = v;
                if (*v == '"') {
                    v_end = v + 1;
                    while (v_end < old_buf + old_n && *v_end != '"') {
                        if (*v_end == '\\' && v_end + 1 < old_buf + old_n) v_end++;
                        v_end++;
                    }
                    if (v_end < old_buf + old_n) v_end++;
                } else if (*v == '{' || *v == '[') {
                    char open = *v; char close = (open == '{') ? '}' : ']';
                    int depth = 0;
                    v_end = v;
                    while (v_end < old_buf + old_n) {
                        if (*v_end == open) depth++;
                        else if (*v_end == close) {
                            depth--;
                            if (depth == 0) { v_end++; break; }
                        }
                        v_end++;
                    }
                } else {
                    while (v_end < old_buf + old_n
                           && *v_end != ',' && *v_end != '}'
                           && *v_end != ' ' && *v_end != '\n'
                           && *v_end != '\r' && *v_end != '\t') v_end++;
                }
                int prefix_n = (int)(v - old_buf);
                int suffix_n = old_n - (int)(v_end - old_buf);
                n = snprintf(new_buf, sizeof(new_buf), "%.*s%s%.*s",
                              prefix_n, old_buf, json_literal,
                              suffix_n, v_end);
            } else {
                int close_at = -1;
                for (int i = old_n - 1; i >= 0; i--) {
                    if (old_buf[i] == '}') { close_at = i; break; }
                }
                if (close_at < 0) return 0;
                int has_fields = 0;
                for (int i = 0; i < close_at; i++) {
                    char c = old_buf[i];
                    if (c == ':') { has_fields = 1; break; }
                }
                const char* sep = has_fields ? "," : "";
                n = snprintf(new_buf, sizeof(new_buf),
                              "%.*s%s\"%s\":%s%.*s",
                              close_at, old_buf, sep, key, json_literal,
                              old_n - close_at, old_buf + close_at);
            }
        }

        if (n <= 0 || n >= (int) sizeof(new_buf)) return 0;
        return _pollen_state_write(root_mid, new_buf, (size_t) n);
    }

    /* ── set-op storage ─────────────────────────────────────────
     *
     * AM-side load registers up to N (path, value_lit) pairs to be
     * applied to the state file before each forward. Cleared on
     * reload alongside cond/next state. */
    #define POLLEN_SET_OPS_MAX 8

    typedef struct {
        char path[POLLEN_COND_VAR_MAX];
        /* Raw JSON of the value expression — evaluated per-message
         * at apply time via _pollen_eval_expr. 1 KiB is enough for
         * common counter / pluck-from-data patterns ; Phase 5.3.2
         * will grow it if real workflows hit the limit. */
        char value_expr[1024];
    } pollen_set_op_t;

    static pollen_set_op_t _pollen_set_ops[POLLEN_SET_OPS_MAX];
    /* _pollen_n_set_ops declared in the early @c block (hoisted for
     * reload_begin). */

    static void _pollen_set_ops_clear(void) {
        _pollen_n_set_ops = 0;
    }

    static void _pollen_set_ops_add(const char* path,
                                      const char* value_expr) {
        if (_pollen_n_set_ops >= POLLEN_SET_OPS_MAX) return;
        pollen_set_op_t* o = &_pollen_set_ops[_pollen_n_set_ops];
        strncpy(o->path, path, POLLEN_COND_VAR_MAX - 1);
        o->path[POLLEN_COND_VAR_MAX - 1] = 0;
        strncpy(o->value_expr, value_expr, sizeof(o->value_expr) - 1);
        o->value_expr[sizeof(o->value_expr) - 1] = 0;
        _pollen_n_set_ops++;
    }

    /* Extract rootMessageId from the envelope. Returns 1 on success. */
    static int _pollen_extract_root_mid(const char* env, size_t env_len,
                                          char* out, size_t cap) {
        const char* k = _pollen_find(env, env_len,
                                       "\"rootMessageId\":\"", 17);
        if (!k) return 0;
        const char* v = k + 17;
        const char* q = memchr(v, '"', env_len - (size_t)(v - env));
        if (!q) return 0;
        size_t rlen = (size_t)(q - v);
        if (rlen == 0 || rlen >= cap) return 0;
        memcpy(out, v, rlen); out[rlen] = 0;
        return 1;
    }

    /* ── Phase 5.3.1 — Expr evaluator ───────────────────────────
     *
     * `set.value` (and any other slot that accepts an expression in
     * later phases) is stored as raw JSON text and walked recursively
     * here at apply time. Supported forms :
     *   {"const": <JSON literal>}
     *   {"var":   "data.X" | "state.X"}
     *   {"op":    "+|-|*|/", "left": <Expr>, "right": <Expr>}
     * Numbers propagate as doubles ; strings are passed through for
     * const + var (arithmetic on strings returns 0). Recursion is
     * bounded by the byte budget of the surrounding storage slot
     * (~1 KiB per set value), so no explicit depth cap needed yet. */

    typedef struct {
        int is_num;
        double num;
        char str[128];
    } _pollen_expr_val_t;

    /* Find `"key":<value>` inside a JSON object, returning the raw
     * value extent. Brace + bracket + string aware. Used by the Expr
     * walker — not a general-purpose JSON parser. */
    static int _pollen_json_field(const char* buf, size_t len,
                                    const char* key, int klen,
                                    const char** out_v, size_t* out_vlen) {
        char needle[80];
        int nlen = snprintf(needle, sizeof(needle), "\"%.*s\":", klen, key);
        if (nlen <= 0 || nlen >= (int) sizeof(needle)) return 0;
        const char* k = _pollen_find(buf, len, needle, (size_t) nlen);
        if (!k) return 0;
        const char* v = k + nlen;
        while (v < buf + len && (*v == ' ' || *v == '\t')) v++;
        if (v >= buf + len) return 0;
        const char* e = v;
        if (*v == '"') {
            e = v + 1;
            while (e < buf + len) {
                if (*e == '\\' && e + 1 < buf + len) { e += 2; continue; }
                if (*e == '"') { e++; break; }
                e++;
            }
        } else if (*v == '{' || *v == '[') {
            char open = *v; char close = (open == '{') ? '}' : ']';
            int depth = 0;
            int in_str = 0;
            e = v;
            while (e < buf + len) {
                char c = *e;
                if (in_str) {
                    if (c == '\\' && e + 1 < buf + len) { e += 2; continue; }
                    if (c == '"') in_str = 0;
                } else {
                    if (c == '"') in_str = 1;
                    else if (c == open) depth++;
                    else if (c == close) {
                        depth--;
                        if (depth == 0) { e++; break; }
                    }
                }
                e++;
            }
        } else {
            while (e < buf + len && *e != ',' && *e != '}' && *e != ']'
                   && *e != ' ' && *e != '\n' && *e != '\r' && *e != '\t') e++;
        }
        *out_v = v;
        *out_vlen = (size_t)(e - v);
        return 1;
    }

    /* Read the first key of a JSON object expression. Returns the
     * key name into `out_key` (max cap chars), and `out_key_len` is
     * the actual length. 0 on failure. This is what disambiguates
     * the eval dispatch — `_pollen_json_field` substring-searches
     * the whole expr, which would treat `{"op":"+","right":{"const":1}}`
     * as a const literal because "const" appears nested.
     *
     * Walks until the first `"`, copies until matching `"`. Cheaply
     * handles whitespace between `{` and the key. */
    static int _pollen_expr_outer_key(const char* expr, size_t expr_len,
                                        char* out_key, size_t cap) {
        const char* e = expr;
        const char* end = expr + expr_len;
        while (e < end && (*e == ' ' || *e == '\t' || *e == '\n' || *e == '\r')) e++;
        if (e >= end || *e != '{') return 0;
        e++;
        while (e < end && (*e == ' ' || *e == '\t' || *e == '\n' || *e == '\r')) e++;
        if (e >= end || *e != '"') return 0;
        e++;
        const char* k0 = e;
        while (e < end && *e != '"') {
            if (*e == '\\' && e + 1 < end) { e += 2; continue; }
            e++;
        }
        if (e >= end) return 0;
        size_t klen = (size_t)(e - k0);
        if (klen == 0 || klen >= cap) return 0;
        memcpy(out_key, k0, klen);
        out_key[klen] = 0;
        return 1;
    }

    static int _pollen_eval_expr(const char* env, size_t env_len,
                                   const char* expr, size_t expr_len,
                                   _pollen_expr_val_t* out) {
        out->is_num = 0;
        out->num = 0;
        out->str[0] = 0;
        const char* v; size_t vlen;

        /* Pick the dispatch based on the outermost key of the
         * expression object. Otherwise nested "const" / "var" / "op"
         * inside a compound would shadow the real form. */
        char outer_key[16];
        if (!_pollen_expr_outer_key(expr, expr_len, outer_key, sizeof(outer_key))) {
            return 0;
        }

        if (strcmp(outer_key, "const") == 0
            && _pollen_json_field(expr, expr_len, "const", 5, &v, &vlen)) {
            if (vlen == 0) return 0;
            if (*v == '"') {
                size_t slen = vlen >= 2 ? vlen - 2 : 0;
                if (slen >= sizeof(out->str)) slen = sizeof(out->str) - 1;
                memcpy(out->str, v + 1, slen);
                out->str[slen] = 0;
                out->is_num = 0;
            } else {
                char tmp[64];
                size_t cn = vlen < sizeof(tmp) - 1 ? vlen : sizeof(tmp) - 1;
                memcpy(tmp, v, cn); tmp[cn] = 0;
                out->num = atof(tmp);
                out->is_num = 1;
            }
            return 1;
        }

        if (strcmp(outer_key, "var") == 0
            && _pollen_json_field(expr, expr_len, "var", 3, &v, &vlen)) {
            if (vlen < 2 || *v != '"') return 0;
            char path[POLLEN_COND_VAR_MAX];
            size_t plen = vlen - 2;
            if (plen >= sizeof(path)) plen = sizeof(path) - 1;
            memcpy(path, v + 1, plen); path[plen] = 0;

            const char* lookup_buf = env;
            size_t lookup_len = env_len;
            const char* lookup_path = path;
            char state_buf[POLLEN_STATE_FILE_MAX];
            if (strncmp(path, "state.", 6) == 0) {
                char root[64];
                if (!env || !_pollen_extract_root_mid(env, env_len,
                                                        root, sizeof(root))) {
                    out->is_num = 1; out->num = 0;
                    return 1;
                }
                int sn = _pollen_state_read(root, state_buf, sizeof(state_buf));
                if (sn <= 0) {
                    /* Missing state — treat as numeric 0 so a
                     * counter increment from absent → 1 works. */
                    out->is_num = 1; out->num = 0;
                    return 1;
                }
                lookup_buf = state_buf;
                lookup_len = (size_t) sn;
                lookup_path = path + 6;
            }
            const char* vp; size_t vl;
            if (!_pollen_resolve_path(lookup_buf, lookup_len,
                                        lookup_path, &vp, &vl)) {
                out->is_num = 1; out->num = 0;
                return 1;
            }
            if (*vp == '"') {
                size_t slen = vl >= 2 ? vl - 2 : 0;
                if (slen >= sizeof(out->str)) slen = sizeof(out->str) - 1;
                memcpy(out->str, vp + 1, slen); out->str[slen] = 0;
                out->is_num = 0;
            } else {
                char tmp[64];
                size_t cn = vl < sizeof(tmp) - 1 ? vl : sizeof(tmp) - 1;
                memcpy(tmp, vp, cn); tmp[cn] = 0;
                out->num = atof(tmp);
                out->is_num = 1;
            }
            return 1;
        }

        if (strcmp(outer_key, "op") == 0
            && _pollen_json_field(expr, expr_len, "op", 2, &v, &vlen)) {
            if (vlen < 2 || *v != '"') return 0;
            char op[16];
            size_t olen = vlen - 2;
            if (olen >= sizeof(op)) return 0;
            memcpy(op, v + 1, olen); op[olen] = 0;

            const char* lv; size_t llen;
            const char* rv; size_t rlen;
            if (!_pollen_json_field(expr, expr_len, "left", 4,
                                      &lv, &llen)) return 0;
            if (!_pollen_json_field(expr, expr_len, "right", 5,
                                      &rv, &rlen)) return 0;
            _pollen_expr_val_t lvv, rvv;
            if (!_pollen_eval_expr(env, env_len, lv, llen, &lvv)) return 0;
            if (!_pollen_eval_expr(env, env_len, rv, rlen, &rvv)) return 0;
            if (!lvv.is_num || !rvv.is_num) return 0;
            out->is_num = 1;
            if (strcmp(op, "+") == 0) out->num = lvv.num + rvv.num;
            else if (strcmp(op, "-") == 0) out->num = lvv.num - rvv.num;
            else if (strcmp(op, "*") == 0) out->num = lvv.num * rvv.num;
            else if (strcmp(op, "/") == 0) out->num = (rvv.num == 0) ? 0 : lvv.num / rvv.num;
            else return 0;
            return 1;
        }

        return 0;
    }

    static int _pollen_expr_val_to_literal(_pollen_expr_val_t* v,
                                             char* out, size_t cap) {
        if (v->is_num) {
            double rounded = (double)(long long) v->num;
            if (rounded == v->num
                && v->num >= -9.2e18 && v->num <= 9.2e18) {
                return snprintf(out, cap, "%lld", (long long) v->num);
            }
            return snprintf(out, cap, "%g", v->num);
        }
        /* Re-escape minimal : we expect no embedded quotes in the
         * eval result for the MVP. Phase 5.3.2 will round-trip
         * through JsonEscape if needed. */
        return snprintf(out, cap, "\"%s\"", v->str);
    }

    /* Apply all pending set ops against the state file for the
     * envelope's rootMessageId. Best-effort : skip silently if the
     * envelope lacks rootMessageId or if write fails. */
    static void _pollen_set_ops_apply(const char* env, size_t env_len) {
        if (_pollen_n_set_ops == 0) return;
        char root[64];
        if (!_pollen_extract_root_mid(env, env_len, root, sizeof(root))) return;
        for (int i = 0; i < _pollen_n_set_ops; i++) {
            pollen_set_op_t* o = &_pollen_set_ops[i];
            _pollen_expr_val_t val;
            size_t elen = strlen(o->value_expr);
            if (!_pollen_eval_expr(env, env_len, o->value_expr, elen, &val)) {
                fprintf(stdout, "state-set: %s = ?? (expr eval failed: %s)\n",
                    o->path, o->value_expr);
                fflush(stdout);
                continue;
            }
            char lit[256];
            int ln = _pollen_expr_val_to_literal(&val, lit, sizeof(lit));
            if (ln <= 0 || ln >= (int) sizeof(lit)) continue;
            if (_pollen_state_set(root, o->path, lit)) {
                fprintf(stdout, "state-set: %s = %s (root=%s)\n",
                    o->path, lit, root);
                fflush(stdout);
            }
        }
    }

    /* Phase 5.4.1 — leaf comparison. Walks dotted var path, parses
     * value extent, applies op. Same body as the old eval, factored
     * out so the composite walker can reuse it. */
    static int _pollen_cond_eval_leaf(const char* env, size_t env_len,
                                        const char* var_path,
                                        int op_code,
                                        int rhs_is_num,
                                        double rhs_num,
                                        const char* rhs_str) {
        if (op_code == POLLEN_COND_NONE) return 1;
        const char* lookup_buf = env;
        size_t lookup_len = env_len;
        const char* lookup_path = var_path;
        char state_buf[POLLEN_STATE_FILE_MAX];
        if (strncmp(var_path, "state.", 6) == 0) {
            char root[64];
            if (!_pollen_extract_root_mid(env, env_len,
                                            root, sizeof(root))) return 0;
            int sn = _pollen_state_read(root, state_buf, sizeof(state_buf));
            if (sn <= 0) return 0;
            lookup_buf = state_buf;
            lookup_len = (size_t) sn;
            lookup_path = var_path + 6;
        }
        const char* val_ptr = NULL;
        size_t val_len = 0;
        if (!_pollen_resolve_path(lookup_buf, lookup_len, lookup_path,
                                    &val_ptr, &val_len)) return 0;
        const char* v = val_ptr;
        const char* v_end = val_ptr + val_len;
        if (v >= v_end) return 0;
        double v_num = 0; int v_is_num = 0;
        char v_str[128] = "";
        if (*v == '"') {
            const char* q = v_end - 1;
            if (q <= v) return 0;
            size_t slen = (size_t)(q - v - 1);
            if (slen >= sizeof(v_str)) slen = sizeof(v_str) - 1;
            memcpy(v_str, v + 1, slen);
            v_str[slen] = 0;
        } else if ((*v >= '0' && *v <= '9') || *v == '-' || *v == '+' || *v == '.') {
            char tmp[64];
            size_t cn = val_len < sizeof(tmp) - 1 ? val_len : sizeof(tmp) - 1;
            memcpy(tmp, v, cn); tmp[cn] = 0;
            v_num = atof(tmp);
            v_is_num = 1;
        } else if (val_len == 4 && memcmp(v, "true", 4) == 0) {
            strcpy(v_str, "true");
        } else if (val_len == 5 && memcmp(v, "false", 5) == 0) {
            strcpy(v_str, "false");
        } else if (val_len == 4 && memcmp(v, "null", 4) == 0) {
            strcpy(v_str, "null");
        } else {
            return 0;
        }
        if (rhs_is_num && v_is_num) {
            double d = v_num - rhs_num;
            switch (op_code) {
                case POLLEN_COND_EQ: return d == 0;
                case POLLEN_COND_NE: return d != 0;
                case POLLEN_COND_LT: return d <  0;
                case POLLEN_COND_GT: return d >  0;
                case POLLEN_COND_LE: return d <= 0;
                case POLLEN_COND_GE: return d >= 0;
            }
        } else if (!rhs_is_num) {
            int c = strcmp(v_str, rhs_str);
            switch (op_code) {
                case POLLEN_COND_EQ: return c == 0;
                case POLLEN_COND_NE: return c != 0;
                case POLLEN_COND_LT: return c <  0;
                case POLLEN_COND_GT: return c >  0;
                case POLLEN_COND_LE: return c <= 0;
                case POLLEN_COND_GE: return c >= 0;
            }
        }
        return 0;
    }

    /* Phase 5.4.1 — recursive cond eval over raw JSON. Empty expr
     * (else branch) → true. Composite forms :
     *   {"op":"and|or", "args":[<Cond>, …]}
     *   {"op":"not",    "arg":<Cond>}
     * Otherwise treated as a leaf : op is one of ==/!=/</>/<=/>=,
     * with `var` and `value` fields. */
    static int _pollen_cond_eval_expr(const char* env, size_t env_len,
                                        const char* expr, size_t expr_len) {
        if (expr_len == 0) return 1;
        char outer_key[16];
        if (!_pollen_expr_outer_key(expr, expr_len,
                                      outer_key, sizeof(outer_key))) return 0;
        if (strcmp(outer_key, "op") != 0) return 0;

        const char* opv; size_t op_len;
        if (!_pollen_json_field(expr, expr_len, "op", 2, &opv, &op_len)) return 0;
        if (op_len < 2 || *opv != '"') return 0;
        char op[16];
        size_t olen = op_len - 2;
        if (olen >= sizeof(op)) return 0;
        memcpy(op, opv + 1, olen); op[olen] = 0;

        if (strcmp(op, "and") == 0 || strcmp(op, "or") == 0) {
            const char* args; size_t args_len;
            if (!_pollen_json_field(expr, expr_len, "args", 4,
                                      &args, &args_len)) return 0;
            if (args_len < 2 || *args != '[') return 0;
            int is_and = (op[0] == 'a');
            const char* p = args + 1;
            const char* end = args + args_len - 1;
            while (p < end) {
                while (p < end && (*p == ' ' || *p == ',' || *p == '\t' || *p == '\n')) p++;
                if (p >= end) break;
                if (*p != '{') break;
                const char* sp = p;
                int depth = 1; int in_str = 0;
                p++;
                while (p < end && depth > 0) {
                    if (in_str) {
                        if (*p == '\\' && p + 1 < end) { p += 2; continue; }
                        if (*p == '"') in_str = 0;
                    } else {
                        if (*p == '"') in_str = 1;
                        else if (*p == '{') depth++;
                        else if (*p == '}') depth--;
                    }
                    p++;
                }
                int sub_pass = _pollen_cond_eval_expr(env, env_len,
                                                       sp, (size_t)(p - sp));
                if (is_and && !sub_pass) return 0;
                if (!is_and && sub_pass) return 1;
            }
            return is_and ? 1 : 0;
        }

        if (strcmp(op, "not") == 0) {
            const char* arg; size_t arg_len;
            if (!_pollen_json_field(expr, expr_len, "arg", 3,
                                      &arg, &arg_len)) return 0;
            return !_pollen_cond_eval_expr(env, env_len, arg, arg_len);
        }

        /* Phase 6.0a — membership : {op:"in"|"not_in", var, values:[…]}.
         * Resolves the variable, iterates `values`, true if any
         * element string-matches (or none, for not_in). Common case
         * is `data.tier in ["vip","gold"]` — string membership. */
        if (strcmp(op, "in") == 0 || strcmp(op, "not_in") == 0) {
            int negate = (op[0] == 'n');
            const char* varTok; size_t varTokLen;
            if (!_pollen_json_field(expr, expr_len, "var", 3,
                                      &varTok, &varTokLen)) return 0;
            if (varTokLen < 2 || *varTok != '"') return 0;
            char vpath[POLLEN_COND_VAR_MAX];
            size_t vplen = varTokLen - 2;
            if (vplen >= sizeof(vpath)) vplen = sizeof(vpath) - 1;
            memcpy(vpath, varTok + 1, vplen); vpath[vplen] = 0;

            const char* lookup_buf = env;
            size_t lookup_len = env_len;
            const char* lookup_path = vpath;
            char state_buf[POLLEN_STATE_FILE_MAX];
            if (strncmp(vpath, "state.", 6) == 0) {
                char root[64];
                if (!_pollen_extract_root_mid(env, env_len,
                                                root, sizeof(root))) return 0;
                int sn = _pollen_state_read(root, state_buf, sizeof(state_buf));
                if (sn <= 0) return 0;
                lookup_buf = state_buf;
                lookup_len = (size_t) sn;
                lookup_path = vpath + 6;
            }
            const char* val_ptr; size_t val_len;
            if (!_pollen_resolve_path(lookup_buf, lookup_len,
                                        lookup_path, &val_ptr, &val_len)) {
                return negate ? 1 : 0;
            }

            char v_str[128]; v_str[0] = 0;
            if (val_len > 0 && *val_ptr == '"') {
                size_t slen = val_len >= 2 ? val_len - 2 : 0;
                if (slen >= sizeof(v_str)) slen = sizeof(v_str) - 1;
                memcpy(v_str, val_ptr + 1, slen);
                v_str[slen] = 0;
            } else {
                size_t cn = val_len < sizeof(v_str) - 1 ? val_len : sizeof(v_str) - 1;
                memcpy(v_str, val_ptr, cn); v_str[cn] = 0;
            }

            const char* values; size_t values_len;
            if (!_pollen_json_field(expr, expr_len, "values", 6,
                                      &values, &values_len)) return 0;
            if (values_len < 2 || *values != '[') return 0;
            const char* p = values + 1;
            const char* end = values + values_len - 1;
            int found = 0;
            while (p < end) {
                while (p < end && (*p == ' ' || *p == ',' || *p == '\t' || *p == '\n')) p++;
                if (p >= end) break;
                const char* tok = p;
                char tok_buf[128]; tok_buf[0] = 0;
                if (*p == '"') {
                    p++;
                    const char* q = p;
                    while (q < end && *q != '"') {
                        if (*q == '\\' && q + 1 < end) { q += 2; continue; }
                        q++;
                    }
                    size_t slen = (size_t)(q - p);
                    if (slen >= sizeof(tok_buf)) slen = sizeof(tok_buf) - 1;
                    memcpy(tok_buf, p, slen); tok_buf[slen] = 0;
                    p = (q < end) ? q + 1 : q;
                } else {
                    while (p < end && *p != ',' && *p != ']'
                           && *p != ' ' && *p != '\n' && *p != '\r' && *p != '\t') p++;
                    size_t slen = (size_t)(p - tok);
                    if (slen >= sizeof(tok_buf)) slen = sizeof(tok_buf) - 1;
                    memcpy(tok_buf, tok, slen); tok_buf[slen] = 0;
                }
                if (strcmp(tok_buf, v_str) == 0) { found = 1; break; }
            }
            return negate ? (found ? 0 : 1) : (found ? 1 : 0);
        }

        /* Leaf comparison. Decode op code, var, value. */
        int op_code = POLLEN_COND_NONE;
        if      (strcmp(op, "==") == 0) op_code = POLLEN_COND_EQ;
        else if (strcmp(op, "!=") == 0) op_code = POLLEN_COND_NE;
        else if (strcmp(op, "<")  == 0) op_code = POLLEN_COND_LT;
        else if (strcmp(op, ">")  == 0) op_code = POLLEN_COND_GT;
        else if (strcmp(op, "<=") == 0) op_code = POLLEN_COND_LE;
        else if (strcmp(op, ">=") == 0) op_code = POLLEN_COND_GE;
        else return 0;

        const char* var; size_t var_len;
        if (!_pollen_json_field(expr, expr_len, "var", 3,
                                  &var, &var_len)) return 0;
        if (var_len < 2 || *var != '"') return 0;
        char path[POLLEN_COND_VAR_MAX];
        size_t plen = var_len - 2;
        if (plen >= sizeof(path)) plen = sizeof(path) - 1;
        memcpy(path, var + 1, plen); path[plen] = 0;

        const char* val; size_t val_len;
        if (!_pollen_json_field(expr, expr_len, "value", 5,
                                  &val, &val_len)) return 0;
        int rhs_is_num = 0;
        double rhs_num = 0;
        char rhs_str[POLLEN_COND_STR_MAX] = "";
        if (val_len > 0 && *val == '"') {
            size_t slen = val_len >= 2 ? val_len - 2 : 0;
            if (slen >= sizeof(rhs_str)) slen = sizeof(rhs_str) - 1;
            memcpy(rhs_str, val + 1, slen); rhs_str[slen] = 0;
        } else if (val_len > 0 && ((*val >= '0' && *val <= '9')
                   || *val == '-' || *val == '+' || *val == '.')) {
            char tmp[64];
            size_t cn = val_len < sizeof(tmp) - 1 ? val_len : sizeof(tmp) - 1;
            memcpy(tmp, val, cn); tmp[cn] = 0;
            rhs_num = atof(tmp);
            rhs_is_num = 1;
        } else if (val_len == 4 && memcmp(val, "true", 4) == 0) {
            strcpy(rhs_str, "true");
        } else if (val_len == 5 && memcmp(val, "false", 5) == 0) {
            strcpy(rhs_str, "false");
        } else if (val_len == 4 && memcmp(val, "null", 4) == 0) {
            strcpy(rhs_str, "null");
        } else {
            return 0;
        }

        return _pollen_cond_eval_leaf(env, env_len, path, op_code,
                                        rhs_is_num, rhs_num, rhs_str);
    }

    /* Public wrapper kept for the cond forward path. */
    static int _pollen_cond_eval(pollen_cond_branch_t* b,
                                   const char* env, size_t env_len) {
        return _pollen_cond_eval_expr(env, env_len,
                                        b->cond_expr,
                                        strlen(b->cond_expr));
    }

    /* Conditional forward : evaluate branches top-down, first true
     * dispatches to its targets via _pollen_wf_forward_one. The
     * envelope is rewritten once via _pollen_wf_rebuild_envelope
     * (fresh messageId + parent chain + topic) before being sent
     * to every chosen target. */
    static void _pollen_cond_forward(const char* env, size_t env_len,
                                      char* out_new_mid) {
        for (int i = 0; i < _pollen_cond_n_branches; i++) {
            pollen_cond_branch_t* b = &_pollen_cond_branches[i];
            if (_pollen_cond_eval(b, env, env_len)) {
                char rebuilt[8192];
                const char* fwd = env;
                size_t fwd_len = env_len;
                const char* new_topic = _pollen_wf_emit_topic[0] ?
                                        _pollen_wf_emit_topic : NULL;
                size_t rn = _pollen_wf_rebuild_envelope(env, env_len,
                                                         rebuilt, sizeof(rebuilt),
                                                         new_topic, out_new_mid);
                if (rn > 0) { fwd = rebuilt; fwd_len = rn; }
                for (int t = 0; t < b->n_targets; t++) {
                    _pollen_wf_forward_one(b->targets_host[t],
                                            b->targets_port[t],
                                            fwd, fwd_len);
                }
                fprintf(stdout,
                    "tree-if: branch[%d] matched → forwarded to %d target(s)\n",
                    i, b->n_targets);
                fflush(stdout);
                return;
            }
        }
        fprintf(stdout, "tree-if: no branch matched → drop\n");
        fflush(stdout);
    }

    /* ── Phase 5.4 — `for` loop (per-item fan-out) ──────────────
     *
     * `for var in [items] do <action>` clones the message N times
     * (one per item). Before each dispatch, `state.<var>` is set to
     * the item's JSON literal so the downstream node can read it.
     * Items are static literals captured at workflow-load time and
     * stay constant across all messages.
     *
     * Limitation : `do` must resolve to a single dispatcher target.
     * Phase 5.4.3 extended to multi-target `do` (do can be a
     * fan_out, a sequence, or any composite — we register every
     * resolvable target). Each iteration sets state.<var> to the
     * current item, then forwards to all targets in turn. */
    #define POLLEN_FOR_MAX_ITEMS 32
    #define POLLEN_FOR_ITEM_MAX  256

    typedef struct {
        char items[POLLEN_FOR_MAX_ITEMS][POLLEN_FOR_ITEM_MAX];
        int  n_items;
        char item_var[POLLEN_COND_VAR_MAX];
        /* Phase 5.4.3 — array of (host, port) targets (was single). */
        char target_host[POLLEN_MAX_NEXTS][POLLEN_HOST_MAX];
        int  target_port[POLLEN_MAX_NEXTS];
        int  n_targets;
    } pollen_for_route_t;

    static pollen_for_route_t _pollen_for_route;

    static void _pollen_for_setup(const char* var) {
        _pollen_for_active = 1;
        _pollen_for_route.n_items = 0;
        _pollen_for_route.n_targets = 0;
        strncpy(_pollen_for_route.item_var, var ? var : "item",
                 POLLEN_COND_VAR_MAX - 1);
        _pollen_for_route.item_var[POLLEN_COND_VAR_MAX - 1] = 0;
    }

    static void _pollen_for_add_target(const char* host, int port) {
        if (_pollen_for_route.n_targets >= POLLEN_MAX_NEXTS) return;
        strncpy(_pollen_for_route.target_host[_pollen_for_route.n_targets],
                 host ? host : "", POLLEN_HOST_MAX - 1);
        _pollen_for_route.target_host[_pollen_for_route.n_targets][POLLEN_HOST_MAX - 1] = 0;
        _pollen_for_route.target_port[_pollen_for_route.n_targets] = port;
        _pollen_for_route.n_targets++;
    }

    static void _pollen_for_add_item(const char* item_lit) {
        if (_pollen_for_route.n_items >= POLLEN_FOR_MAX_ITEMS) return;
        strncpy(_pollen_for_route.items[_pollen_for_route.n_items],
                 item_lit ? item_lit : "null",
                 POLLEN_FOR_ITEM_MAX - 1);
        _pollen_for_route.items[_pollen_for_route.n_items][POLLEN_FOR_ITEM_MAX - 1] = 0;
        _pollen_for_route.n_items++;
    }

    static void _pollen_for_forward(const char* env, size_t env_len,
                                      char* out_new_mid) {
        char root[64];
        int have_root = _pollen_extract_root_mid(env, env_len, root, sizeof(root));
        const char* var = _pollen_for_route.item_var;
        char state_path[POLLEN_COND_VAR_MAX + 8];
        if (strncmp(var, "state.", 6) == 0) {
            snprintf(state_path, sizeof(state_path), "%s", var);
        } else {
            snprintf(state_path, sizeof(state_path), "state.%s", var);
        }
        int total = 0;
        for (int i = 0; i < _pollen_for_route.n_items; i++) {
            const char* item = _pollen_for_route.items[i];
            if (have_root) {
                if (_pollen_state_set(root, state_path, item)) {
                    fprintf(stdout, "for-loop: iter[%d] %s = %s (root=%s)\n",
                        i, state_path, item, root);
                }
            }
            char rebuilt[8192];
            const char* new_topic = _pollen_wf_emit_topic[0]
                                    ? _pollen_wf_emit_topic : NULL;
            size_t rn = _pollen_wf_rebuild_envelope(env, env_len,
                                                     rebuilt, sizeof(rebuilt),
                                                     new_topic, out_new_mid);
            const char* fwd = rn > 0 ? rebuilt : env;
            size_t fwd_len = rn > 0 ? rn : env_len;
            for (int t = 0; t < _pollen_for_route.n_targets; t++) {
                _pollen_wf_forward_one(_pollen_for_route.target_host[t],
                                        _pollen_for_route.target_port[t],
                                        fwd, fwd_len);
                total++;
            }
        }
        fprintf(stdout,
            "for-loop: fanned out %d iter(s) × %d target(s) = %d msg(s)\n",
            _pollen_for_route.n_items, _pollen_for_route.n_targets, total);
        fflush(stdout);
    }

    /* ── Phase 5.4 — `while` loop (self-loop with cond + maxIter) ──
     *
     * After the parent role finishes, the while step re-evaluates :
     *   - cond true  AND iter < maxIter → forward to self (loop)
     *   - else                          → forward to exit targets
     * A hidden iter counter is auto-managed under a state key
     * derived from the role name + a per-while suffix so multiple
     * while loops on different roles don't collide. The cond can
     * reference state.X / data.X via the same path syntax as `if`.
     *
     * Phase 5.4.1 — cond stored as raw JSON, same form as `if`
     * branches : composite via and/or/not on top of leaf comparisons. */
    typedef struct {
        char  cond_expr[POLLEN_COND_EXPR_MAX];
        /* Auto-iter slot in the state file */
        char  iter_state_key[POLLEN_COND_VAR_MAX];
        int   max_iter;
        /* Loop target = self */
        char  loop_host[POLLEN_HOST_MAX];
        int   loop_port;
        /* Exit targets = whatever follows the while in the outer
         * sequence. Reuse the same MAX_NEXTS sizing. */
        char  exit_host[POLLEN_MAX_NEXTS][POLLEN_HOST_MAX];
        int   exit_port[POLLEN_MAX_NEXTS];
        int   n_exits;
    } pollen_while_route_t;

    static pollen_while_route_t _pollen_while_route;

    static void _pollen_while_setup_expr(const char* cond_json,
                                           const char* iter_key,
                                           int max_iter,
                                           const char* self_host,
                                           int self_port) {
        _pollen_while_active = 1;
        strncpy(_pollen_while_route.cond_expr, cond_json ? cond_json : "",
                 POLLEN_COND_EXPR_MAX - 1);
        _pollen_while_route.cond_expr[POLLEN_COND_EXPR_MAX - 1] = 0;
        strncpy(_pollen_while_route.iter_state_key,
                 iter_key ? iter_key : "_wf_iter",
                 POLLEN_COND_VAR_MAX - 1);
        _pollen_while_route.iter_state_key[POLLEN_COND_VAR_MAX - 1] = 0;
        _pollen_while_route.max_iter = max_iter > 0 ? max_iter : 100;
        strncpy(_pollen_while_route.loop_host, self_host ? self_host : "",
                 POLLEN_HOST_MAX - 1);
        _pollen_while_route.loop_host[POLLEN_HOST_MAX - 1] = 0;
        _pollen_while_route.loop_port = self_port;
        _pollen_while_route.n_exits = 0;
    }

    static void _pollen_while_add_exit(const char* host, int port) {
        if (_pollen_while_route.n_exits >= POLLEN_MAX_NEXTS) return;
        strncpy(_pollen_while_route.exit_host[_pollen_while_route.n_exits],
                 host ? host : "", POLLEN_HOST_MAX - 1);
        _pollen_while_route.exit_host[_pollen_while_route.n_exits][POLLEN_HOST_MAX - 1] = 0;
        _pollen_while_route.exit_port[_pollen_while_route.n_exits] = port;
        _pollen_while_route.n_exits++;
    }

    /* Read iter from state, evaluate user cond, decide loop vs exit.
     * On loop : increment iter, forward to self. On exit : forward
     * to each exit target. The auto-iter is checked BEFORE the user
     * cond so a runaway loop always terminates eventually. */
    static void _pollen_while_forward(const char* env, size_t env_len,
                                        char* out_new_mid) {
        char root[64];
        int have_root = _pollen_extract_root_mid(env, env_len, root, sizeof(root));
        int iter = 0;
        if (have_root) {
            char state_buf[POLLEN_STATE_FILE_MAX];
            int sn = _pollen_state_read(root, state_buf, sizeof(state_buf));
            if (sn > 0) {
                const char* vp; size_t vl;
                if (_pollen_resolve_path(state_buf, (size_t) sn,
                                           _pollen_while_route.iter_state_key,
                                           &vp, &vl)) {
                    char tmp[32];
                    size_t cn = vl < sizeof(tmp) - 1 ? vl : sizeof(tmp) - 1;
                    memcpy(tmp, vp, cn); tmp[cn] = 0;
                    iter = atoi(tmp);
                }
            }
        }

        int hit_max = (iter >= _pollen_while_route.max_iter);
        int cond_pass = _pollen_cond_eval_expr(env, env_len,
                                                 _pollen_while_route.cond_expr,
                                                 strlen(_pollen_while_route.cond_expr));

        if (!hit_max && cond_pass) {
            /* Loop iteration : bump iter, forward to self. */
            if (have_root) {
                char lit[32];
                snprintf(lit, sizeof(lit), "%d", iter + 1);
                _pollen_state_set(root,
                                    _pollen_while_route.iter_state_key,
                                    lit);
            }
            char rebuilt[8192];
            const char* new_topic = _pollen_wf_emit_topic[0]
                                    ? _pollen_wf_emit_topic : NULL;
            size_t rn = _pollen_wf_rebuild_envelope(env, env_len,
                                                     rebuilt, sizeof(rebuilt),
                                                     new_topic, out_new_mid);
            const char* fwd = rn > 0 ? rebuilt : env;
            size_t fwd_len = rn > 0 ? rn : env_len;
            _pollen_wf_forward_one(_pollen_while_route.loop_host,
                                    _pollen_while_route.loop_port,
                                    fwd, fwd_len);
            fprintf(stdout, "while-loop: iter=%d → loop to %s:%d\n",
                iter + 1,
                _pollen_while_route.loop_host,
                _pollen_while_route.loop_port);
            fflush(stdout);
            return;
        }

        /* Exit branch. */
        const char* reason = hit_max ? "maxIter" : "cond false";
        fprintf(stdout, "while-loop: exit at iter=%d (%s) → %d exit target(s)\n",
            iter, reason, _pollen_while_route.n_exits);
        fflush(stdout);
        if (_pollen_while_route.n_exits == 0) return;

        char rebuilt[8192];
        const char* new_topic = _pollen_wf_emit_topic[0]
                                ? _pollen_wf_emit_topic : NULL;
        size_t rn = _pollen_wf_rebuild_envelope(env, env_len,
                                                 rebuilt, sizeof(rebuilt),
                                                 new_topic, out_new_mid);
        const char* fwd = rn > 0 ? rebuilt : env;
        size_t fwd_len = rn > 0 ? rn : env_len;
        for (int i = 0; i < _pollen_while_route.n_exits; i++) {
            _pollen_wf_forward_one(_pollen_while_route.exit_host[i],
                                    _pollen_while_route.exit_port[i],
                                    fwd, fwd_len);
        }
    }

    /* Portable substring search — memmem is glibc-only and _GNU_SOURCE
     * has to be defined before any system header which is hard to
     * guarantee from inside an amc @c block. Naive O(h × n) is fine
     * for our 13-byte needle scanning <2 KB lines. */
    static const char* _pollen_find(const char* hay, size_t hlen,
                                     const char* needle, size_t nlen) {
        if (nlen == 0 || hlen < nlen) return NULL;
        const char* end = hay + hlen - nlen;
        for (const char* p = hay; p <= end; p++) {
            if (memcmp(p, needle, nlen) == 0) return p;
        }
        return NULL;
    }

    /* ── publisher hot path (Phase 2.4d) ─────────────
     *
     * Replaces the entire AM-side pipeline-send + drain-ACK loop.
     * Connects, fires `count` MESSAGEs (UUIDv4 mid generated via
     * getrandom + RFC 4122 bit-fix, envelope built via snprintf,
     * dataTemplate has one %d substitution for the iter index),
     * then drains `count` ACK lines and matches them by messageId.
     * Returns the count of matched ACKs.
     *
     * Logging stays compatible with the bench parser — fprintf to
     * stdout per send + per ACK. fprintf is line-buffered to a
     * pipe (typical bench run), so a single fflush at the end is
     * enough to surface everything before the process exits.
     */
    #include <sys/random.h>
    #include <netinet/in.h>
    #include <arpa/inet.h>

    static int pollen_hot_publish_stream(
            const char* peerIp, int64_t peerPort,
            const char* topicUuid, int64_t topicVersion,
            const char* dataTemplate, int64_t count) {
        int fd = socket(AF_INET, SOCK_STREAM, 0);
        if (fd < 0) return 0;
        struct sockaddr_in addr; memset(&addr, 0, sizeof(addr));
        addr.sin_family = AF_INET;
        addr.sin_port   = htons((uint16_t) peerPort);
        if (inet_pton(AF_INET, peerIp, &addr.sin_addr) != 1) { close(fd); return 0; }
        if (connect(fd, (struct sockaddr*) &addr, sizeof(addr)) < 0) { close(fd); return 0; }

        const char* hex = "0123456789abcdef";
        /* Stash every sent mid so we can match ACKs in arrival
         * order. 40 bytes/slot keeps a 100k-msg batch under 4 MiB. */
        char* mids = (char*) malloc((size_t) count * 40);
        if (!mids) { close(fd); return 0; }

        char envelope[4096];
        char data[256];

        for (int64_t i = 0; i < count; i++) {
            unsigned char b[16];
            getrandom(b, 16, 0);
            b[6] = (unsigned char)((b[6] & 0x0F) | 0x40);
            b[8] = (unsigned char)((b[8] & 0x3F) | 0x80);
            char* m = mids + i * 40;
            int p = 0;
            for (int k = 0; k < 16; k++) {
                if (k == 4 || k == 6 || k == 8 || k == 10) m[p++] = '-';
                m[p++] = hex[(b[k] >> 4) & 0xF];
                m[p++] = hex[b[k] & 0xF];
            }
            m[p] = '\0';

            int dlen = snprintf(data, sizeof(data), dataTemplate, (int) i);
            int64_t now = _pollen_now_ms_c();
            int env_len = snprintf(envelope, sizeof(envelope),
                "{\"messageId\":\"%s\",\"rootMessageId\":\"%s\","
                "\"type\":\"MESSAGE\","
                "\"topic\":{\"uuid\":\"%s\",\"version\":%lld},"
                "\"data\":%s,\"timestamp\":%lld}\n",
                m, m, topicUuid, (long long) topicVersion, data, (long long) now);
            (void) dlen;
            if (send(fd, envelope, (size_t) env_len, MSG_NOSIGNAL) < 0) break;
            fprintf(stdout, "publish %s to %s:%lld topic=%s v%lld ts=%lld\n",
                m, peerIp, (long long) peerPort, topicUuid,
                (long long) topicVersion, (long long) now);
        }

        /* drain ACKs */
        char rbuf[16384];
        size_t rlen = 0;
        int64_t got = 0;
        const char* MID_KEY = "\"messageId\":\"";
        const size_t MID_KEY_LEN = 13;

        while (got < count) {
            if (rlen >= sizeof(rbuf)) break;
            ssize_t n = recv(fd, rbuf + rlen, sizeof(rbuf) - rlen, 0);
            if (n <= 0) break;
            rlen += (size_t) n;
            for (;;) {
                char* nl = memchr(rbuf, '\n', rlen);
                if (!nl) break;
                size_t line_len = (size_t)(nl - rbuf);
                const char* mp = _pollen_find(rbuf, line_len,
                    MID_KEY, MID_KEY_LEN);
                if (mp) {
                    mp += MID_KEY_LEN;
                    const char* mq = memchr(mp, '"',
                        line_len - (size_t)(mp - rbuf));
                    if (mq) {
                        size_t midlen = (size_t)(mq - mp);
                        int64_t now = _pollen_now_ms_c();
                        const char* expected = mids + got * 40;
                        int match = (midlen == 36) &&
                            (memcmp(mp, expected, 36) == 0);
                        if (match) {
                            fprintf(stdout,
                                "recv ACK from %s:%lld for %.*s "
                                "(publish complete) ts=%lld\n",
                                peerIp, (long long) peerPort,
                                (int) midlen, mp, (long long) now);
                        } else {
                            fprintf(stdout,
                                "publish FAILED ack-order-mismatch got=%.*s "
                                "expected=%s\n",
                                (int) midlen, mp, expected);
                        }
                    }
                }
                size_t consumed = line_len + 1;
                memmove(rbuf, rbuf + consumed, rlen - consumed);
                rlen -= consumed;
                got++;
                if (got >= count) break;
            }
        }

        fflush(stdout);
        free(mids);
        close(fd);
        return (int) got;
    }

    static void pollen_hot_conn_loop(int fd) {
        /* line-buffered recv. 16 KiB is enough for a few hundred
         * pipelined MESSAGEs before we have to memmove the tail
         * down. Larger payloads would need length-prefix framing
         * — out of scope for this hot path. */
        char rbuf[16384];
        size_t rlen = 0;
        char ack[256];
        const char* MID_KEY = "\"messageId\":\"";
        const size_t MID_KEY_LEN = 13;

        for (;;) {
            if (rlen >= sizeof(rbuf)) {
                /* full buffer with no newline — corrupted/oversize
                 * line. Drop the connection. */
                break;
            }
            ssize_t n = recv(fd, rbuf + rlen, sizeof(rbuf) - rlen, 0);
            if (n <= 0) break;
            rlen += (size_t) n;
            for (;;) {
                char* nl = memchr(rbuf, '\n', rlen);
                if (!nl) break;
                size_t line_len = (size_t)(nl - rbuf);
                /* find messageId — RFC says position doesn't matter
                 * but the publisher in this file always emits it
                 * first so memmem returns quickly. */
                const char* mp = _pollen_find(rbuf, line_len, MID_KEY, MID_KEY_LEN);
                /* Phase 3.1/3.2 — if a workflow is active, extract
                 * topic.uuid from the envelope and decide what to do.
                 * Otherwise (free-form mode) every MESSAGE is ACKed,
                 * matching pre-3.0 behaviour.
                 *
                 *  workflow MODE matrix:
                 *    topic ∈ consumes : ACK + forward to every next
                 *    topic ∉ consumes : drop silently (no ACK)
                 *    (no consumes at all : ACK anyway — pure sink-or-
                 *     pure-producer nodes still need to accept whatever
                 *     reaches them)
                 */
                int do_ack = 1;
                int do_forward = 0;
                const char* topic_start = NULL;
                size_t topic_len = 0;
                /* Take the workflow lock for the whole consume +
                 * forward window. Hot-reload writer holds this for
                 * the brief reload begin/commit; readers hold it
                 * for the snapshot + forward chain. With one
                 * mutex per node (not per conn) contention is low
                 * even at K=32 workers because the critical
                 * section is short. */
                pthread_mutex_lock(&_pollen_wf_mutex);
                if (_pollen_wf_active && _pollen_wf_n_consumes > 0) {
                    /* find topic.uuid — search for "topic":{"uuid":" in
                     * order, then read up to next '"'. The publisher in
                     * this file emits in that order; if reorder ever
                     * happens we'd miss the consume check but still
                     * ACK as a fallback. */
                    const char* TOPIC_KEY = "\"topic\":{\"uuid\":\"";
                    const size_t TOPIC_KEY_LEN = 17;
                    const char* tp = _pollen_find(rbuf, line_len,
                        TOPIC_KEY, TOPIC_KEY_LEN);
                    if (tp) {
                        tp += TOPIC_KEY_LEN;
                        const char* tq = memchr(tp, '"',
                            line_len - (size_t)(tp - rbuf));
                        if (tq) {
                            topic_start = tp;
                            topic_len = (size_t)(tq - tp);
                            if (_pollen_wf_topic_consumed(topic_start, topic_len)) {
                                do_forward = 1;
                            } else {
                                do_ack = 0;  /* not for us, drop */
                            }
                        }
                    }
                }
                if (mp && do_ack) {
                    mp += MID_KEY_LEN;
                    const char* mq = memchr(mp, '"',
                        line_len - (size_t)(mp - rbuf));
                    if (mq) {
                        size_t midlen = (size_t)(mq - mp);
                        int64_t now = _pollen_now_ms_c();
                        int ack_len = snprintf(ack, sizeof(ack),
                            "{\"type\":\"ACK\",\"messageId\":\"%.*s\""
                            ",\"timestamp\":%lld}\n",
                            (int) midlen, mp, (long long) now);
                        /* MSG_NOSIGNAL so a half-closed peer just
                         * makes send return -1 with EPIPE instead
                         * of killing us with SIGPIPE. */
                        send(fd, ack, (size_t) ack_len, MSG_NOSIGNAL);
                        /* Forward AFTER we ACK upstream — the
                         * upstream publish-complete shouldn't wait
                         * on the downstream forward. */
                        if (do_forward) {
                            /* Phase 3.4: surface incoming
                             * parentMessageId so the operator can
                             * trace the chain back to its root.
                             * Absent on producer-published msgs;
                             * present on every forwarded msg. */
                            const char* PAR_KEY = "\"parentMessageId\":\"";
                            const char* pp = _pollen_find(rbuf, line_len,
                                PAR_KEY, 19);
                            const char* parent_start = NULL;
                            size_t parent_len = 0;
                            if (pp) {
                                parent_start = pp + 19;
                                const char* pq = memchr(parent_start, '"',
                                    line_len - (size_t)(parent_start - rbuf));
                                if (pq) {
                                    parent_len = (size_t)(pq - parent_start);
                                }
                            }
                            /* Phase 4.5.1 — surface incoming debug
                             * session id so each hop's record reveals
                             * which debug session it belonged to.
                             * Pure pass-through observation : the
                             * envelope's full debug field is propagated
                             * by _pollen_wf_rebuild_envelope as part
                             * of the data-through-close slice. */
                            const char* DBG_KEY = "\"debug\":{\"session\":\"";
                            const char* dp = _pollen_find(rbuf, line_len,
                                DBG_KEY, 20);
                            const char* dbg_session = NULL;
                            size_t dbg_session_len = 0;
                            if (dp) {
                                dbg_session = dp + 20;
                                const char* dq = memchr(dbg_session, '"',
                                    line_len - (size_t)(dbg_session - rbuf));
                                if (dq) {
                                    dbg_session_len = (size_t)(dq - dbg_session);
                                }
                            }

                            /* Phase 4.5.2 — debug pause / phone-home.
                             * Phase 4.5.4 — mode rewrite on forward.
                             * Phase 4.5.7 — MUTATE handling. */
                            int dbg_dropped = 0;
                            int dbg_pause_cmd = -1;
                            char dbg_resp[8192];
                            dbg_resp[0] = 0;
                            if (dbg_session && dbg_session_len > 0) {
                                int should = _pollen_debug_should_pause(
                                    rbuf, line_len, _pollen_self_role);
                                if (should != POLLEN_DBG_NO_PAUSE) {
                                    char mgr[96];
                                    char sess[64];
                                    int have_mgr = _pollen_debug_extract_manager(
                                        rbuf, line_len, mgr, sizeof(mgr));
                                    int sess_ok = dbg_session_len < sizeof(sess);
                                    if (have_mgr && sess_ok) {
                                        memcpy(sess, dbg_session, dbg_session_len);
                                        sess[dbg_session_len] = 0;
                                        fprintf(stdout,
                                            "debug: pause at role=%s session=%s manager=%s\n",
                                            _pollen_self_role, sess, mgr);
                                        fflush(stdout);
                                        int cmd = _pollen_debug_pause(
                                            rbuf, line_len, mgr, sess,
                                            _pollen_self_role,
                                            dbg_resp, sizeof(dbg_resp));
                                        dbg_pause_cmd = cmd;
                                        const char* cmd_name = "?";
                                        switch (cmd) {
                                            case POLLEN_DBG_STEP_OVER: cmd_name = "STEP_OVER"; break;
                                            case POLLEN_DBG_STEP_INTO: cmd_name = "STEP_INTO"; break;
                                            case POLLEN_DBG_CONTINUE:  cmd_name = "CONTINUE";  break;
                                            case POLLEN_DBG_CANCEL:    cmd_name = "CANCEL";    break;
                                            case POLLEN_DBG_MUTATE:    cmd_name = "MUTATE";    break;
                                            case POLLEN_DBG_TIMEOUT:   cmd_name = "TIMEOUT";   break;
                                            case POLLEN_DBG_NO_CONN:   cmd_name = "NO_CONN";   break;
                                        }
                                        fprintf(stdout,
                                            "debug: resume at role=%s cmd=%s\n",
                                            _pollen_self_role, cmd_name);
                                        fflush(stdout);
                                        if (cmd == POLLEN_DBG_CANCEL
                                            || cmd == POLLEN_DBG_TIMEOUT
                                            || cmd == POLLEN_DBG_NO_CONN) {
                                            dbg_dropped = 1;
                                        }
                                        /* STEP_OVER / STEP_INTO / CONTINUE
                                         * fall through to the normal forward
                                         * path. MUTATE is Phase 4.5.6. */
                                    } else {
                                        fprintf(stdout,
                                            "debug: pause requested but bad envelope (have_mgr=%d sess_ok=%d) at role=%s\n",
                                            have_mgr, sess_ok, _pollen_self_role);
                                        fflush(stdout);
                                    }
                                }
                            }
                            if (dbg_dropped) {
                                /* Skip forward + record. The msg ACK
                                 * has already gone upstream, so the
                                 * producer thinks delivery is done. */
                            } else {

                            /* Phase 4.5.7 — MUTATE handling. The
                             * manager edited the msg.data and sent
                             * a `{"type":"DEBUG_MUTATE","data":<json>,
                             * "then":"continue|step_over|step_into"}`
                             * response. Rewrite envelope.data, then
                             * translate `then` into the equivalent
                             * cmd code so the mode-rewrite pass
                             * below picks it up. */
                            char dbg_mutated[8192];
                            const char* mutate_base = rbuf;
                            size_t mutate_base_len = line_len;
                            if (dbg_pause_cmd == POLLEN_DBG_MUTATE) {
                                size_t data_start = 0, data_end = 0;
                                size_t resp_len = strlen(dbg_resp);
                                if (_pollen_extract_json_value(
                                        dbg_resp, resp_len,
                                        "\"data\":", 7,
                                        &data_start, &data_end)) {
                                    size_t rn = _pollen_debug_rewrite_data(
                                        rbuf, line_len,
                                        dbg_mutated, sizeof(dbg_mutated),
                                        dbg_resp + data_start,
                                        data_end - data_start);
                                    if (rn > 0) {
                                        mutate_base = dbg_mutated;
                                        mutate_base_len = rn;
                                    }
                                }
                                /* Map "then" → cmd code. Default
                                 * to CONTINUE if missing. */
                                const char* t = _pollen_find(dbg_resp,
                                    resp_len, "\"then\":\"", 8);
                                int new_cmd = POLLEN_DBG_CONTINUE;
                                if (t) {
                                    const char* tv = t + 8;
                                    size_t remain = resp_len
                                        - (size_t)(tv - dbg_resp);
                                    if (remain >= 9
                                        && memcmp(tv, "step_into", 9) == 0) {
                                        new_cmd = POLLEN_DBG_STEP_INTO;
                                    } else if (remain >= 9
                                        && memcmp(tv, "step_over", 9) == 0) {
                                        new_cmd = POLLEN_DBG_STEP_OVER;
                                    }
                                }
                                dbg_pause_cmd = new_cmd;
                                fprintf(stdout,
                                    "debug: MUTATE → then=%s (cmd=%d)\n",
                                    new_cmd == POLLEN_DBG_STEP_INTO ? "step_into"
                                    : new_cmd == POLLEN_DBG_STEP_OVER ? "step_over"
                                    : "continue", new_cmd);
                                fflush(stdout);
                            }

                            /* Phase 4.5.4 — rewrite debug.mode +
                             * debug.hit_bp on the forwarded
                             * envelope so downstream nodes see
                             * the operator's intent :
                             *   STEP_INTO/OVER → mode=step, hit_bp=false
                             *   CONTINUE       → mode=breakpoint, hit_bp=false
                             *                    (run to next bp or end)
                             *   (no pause)     → forward as-is
                             */
                            char dbg_rewritten[8192];
                            const char* fwd_buf = mutate_base;
                            size_t fwd_buf_len = mutate_base_len;
                            if (dbg_pause_cmd == POLLEN_DBG_STEP_OVER
                                || dbg_pause_cmd == POLLEN_DBG_STEP_INTO) {
                                size_t rn = _pollen_debug_rewrite(
                                    mutate_base, mutate_base_len,
                                    dbg_rewritten, sizeof(dbg_rewritten),
                                    "step", 0);
                                if (rn > 0) {
                                    fwd_buf = dbg_rewritten;
                                    fwd_buf_len = rn;
                                }
                            } else if (dbg_pause_cmd == POLLEN_DBG_CONTINUE) {
                                size_t rn = _pollen_debug_rewrite(
                                    mutate_base, mutate_base_len,
                                    dbg_rewritten, sizeof(dbg_rewritten),
                                    "breakpoint", 0);
                                if (rn > 0) {
                                    fwd_buf = dbg_rewritten;
                                    fwd_buf_len = rn;
                                }
                            }

                            /* Phase 5.3 — apply pending state set-ops
                             * before routing. The mutated state must
                             * be visible to any conditional eval that
                             * follows on the SAME node ; downstream
                             * nodes will see it via their own state
                             * reads. */
                            _pollen_set_ops_apply(fwd_buf, fwd_buf_len);

                            char fwd_new_mid[37] = {0};
                            if (_pollen_while_active) {
                                /* Phase 5.4 — while loop. Either
                                 * forwards to self (loop body) or to
                                 * exit targets after cond/maxIter
                                 * resolution. */
                                _pollen_while_forward(fwd_buf, fwd_buf_len,
                                                       fwd_new_mid);
                                if (parent_start) {
                                    fprintf(stdout,
                                        "workflow: consumed topic=%.*s "
                                        "msg=%.*s parent=%.*s "
                                        "→ while-route (emit topic=%s)\n",
                                        (int) topic_len, topic_start,
                                        (int) midlen, mp,
                                        (int) parent_len, parent_start,
                                        _pollen_wf_emit_topic[0] ? _pollen_wf_emit_topic : "(verbatim)");
                                } else {
                                    fprintf(stdout,
                                        "workflow: consumed topic=%.*s "
                                        "msg=%.*s (root) "
                                        "→ while-route (emit topic=%s)\n",
                                        (int) topic_len, topic_start,
                                        (int) midlen, mp,
                                        _pollen_wf_emit_topic[0] ? _pollen_wf_emit_topic : "(verbatim)");
                                }
                                if (fwd_new_mid[0]) {
                                    _pollen_wf_record_step(
                                        fwd_new_mid, 36,
                                        mp, midlen,
                                        topic_start, topic_len,
                                        _pollen_wf_emit_topic[0] ?
                                            _pollen_wf_emit_topic : NULL,
                                        1,
                                        dbg_session, dbg_session_len);
                                }
                            } else if (_pollen_for_active) {
                                /* Phase 5.4 — for loop. Fans out one
                                 * copy per item, setting state.<var>
                                 * to the item literal before each
                                 * dispatch. */
                                _pollen_for_forward(fwd_buf, fwd_buf_len,
                                                     fwd_new_mid);
                                if (parent_start) {
                                    fprintf(stdout,
                                        "workflow: consumed topic=%.*s "
                                        "msg=%.*s parent=%.*s "
                                        "→ for-route (emit topic=%s)\n",
                                        (int) topic_len, topic_start,
                                        (int) midlen, mp,
                                        (int) parent_len, parent_start,
                                        _pollen_wf_emit_topic[0] ? _pollen_wf_emit_topic : "(verbatim)");
                                } else {
                                    fprintf(stdout,
                                        "workflow: consumed topic=%.*s "
                                        "msg=%.*s (root) "
                                        "→ for-route (emit topic=%s)\n",
                                        (int) topic_len, topic_start,
                                        (int) midlen, mp,
                                        _pollen_wf_emit_topic[0] ? _pollen_wf_emit_topic : "(verbatim)");
                                }
                                if (fwd_new_mid[0]) {
                                    _pollen_wf_record_step(
                                        fwd_new_mid, 36,
                                        mp, midlen,
                                        topic_start, topic_len,
                                        _pollen_wf_emit_topic[0] ?
                                            _pollen_wf_emit_topic : NULL,
                                        1,
                                        dbg_session, dbg_session_len);
                                }
                            } else if (_pollen_cond_active) {
                                /* Phase 5.2 — conditional routing.
                                 * Branches were resolved at load
                                 * time ; here we just pick the first
                                 * matching one and forward. The
                                 * branch's own targets handle the
                                 * envelope rewrite + new mid. */
                                _pollen_cond_forward(fwd_buf, fwd_buf_len,
                                                      fwd_new_mid);
                                if (parent_start) {
                                    fprintf(stdout,
                                        "workflow: consumed topic=%.*s "
                                        "msg=%.*s parent=%.*s "
                                        "→ if-route (emit topic=%s)\n",
                                        (int) topic_len, topic_start,
                                        (int) midlen, mp,
                                        (int) parent_len, parent_start,
                                        _pollen_wf_emit_topic[0] ? _pollen_wf_emit_topic : "(verbatim)");
                                } else {
                                    fprintf(stdout,
                                        "workflow: consumed topic=%.*s "
                                        "msg=%.*s (root) "
                                        "→ if-route (emit topic=%s)\n",
                                        (int) topic_len, topic_start,
                                        (int) midlen, mp,
                                        _pollen_wf_emit_topic[0] ? _pollen_wf_emit_topic : "(verbatim)");
                                }
                                if (fwd_new_mid[0]) {
                                    _pollen_wf_record_step(
                                        fwd_new_mid, 36,
                                        mp, midlen,
                                        topic_start, topic_len,
                                        _pollen_wf_emit_topic[0] ?
                                            _pollen_wf_emit_topic : NULL,
                                        1,
                                        dbg_session, dbg_session_len);
                                }
                            } else if (_pollen_wf_n_nexts > 0) {
                                _pollen_wf_forward_all(fwd_buf, fwd_buf_len,
                                                       fwd_new_mid);
                                if (parent_start) {
                                    fprintf(stdout,
                                        "workflow: consumed topic=%.*s "
                                        "msg=%.*s parent=%.*s "
                                        "→ forward to %d next-node(s) "
                                        "(emit topic=%s)\n",
                                        (int) topic_len, topic_start,
                                        (int) midlen, mp,
                                        (int) parent_len, parent_start,
                                        _pollen_wf_n_nexts,
                                        _pollen_wf_emit_topic[0] ? _pollen_wf_emit_topic : "(verbatim)");
                                } else {
                                    fprintf(stdout,
                                        "workflow: consumed topic=%.*s "
                                        "msg=%.*s (root) "
                                        "→ forward to %d next-node(s) "
                                        "(emit topic=%s)\n",
                                        (int) topic_len, topic_start,
                                        (int) midlen, mp,
                                        _pollen_wf_n_nexts,
                                        _pollen_wf_emit_topic[0] ? _pollen_wf_emit_topic : "(verbatim)");
                                }
                                /* Phase 3.5 — record the step with
                                 * the new mid that downstream nodes
                                 * will see (parent = incoming mid). */
                                if (fwd_new_mid[0]) {
                                    _pollen_wf_record_step(
                                        fwd_new_mid, 36,
                                        mp, midlen,
                                        topic_start, topic_len,
                                        _pollen_wf_emit_topic[0] ?
                                            _pollen_wf_emit_topic : NULL,
                                        _pollen_wf_n_nexts,
                                        dbg_session, dbg_session_len);
                                }
                            } else {
                                if (parent_start) {
                                    fprintf(stdout,
                                        "workflow: consumed topic=%.*s "
                                        "msg=%.*s parent=%.*s "
                                        "→ terminal (sink)\n",
                                        (int) topic_len, topic_start,
                                        (int) midlen, mp,
                                        (int) parent_len, parent_start);
                                } else {
                                    fprintf(stdout,
                                        "workflow: consumed topic=%.*s "
                                        "msg=%.*s (root) "
                                        "→ terminal (sink)\n",
                                        (int) topic_len, topic_start,
                                        (int) midlen, mp);
                                }
                                /* Phase 3.5 — terminal sink: record
                                 * the leaf step with own mid + parent
                                 * from the incoming envelope. */
                                _pollen_wf_record_step(
                                    mp, midlen,
                                    parent_start, parent_len,
                                    topic_start, topic_len,
                                    NULL,
                                    0,
                                    dbg_session, dbg_session_len);
                            }
                            fflush(stdout);
                            }  /* end else { ... } of dbg_dropped */
                        }
                    }
                }
                pthread_mutex_unlock(&_pollen_wf_mutex);
                size_t consumed = line_len + 1;
                memmove(rbuf, rbuf + consumed, rlen - consumed);
                rlen -= consumed;
            }
        }
    }
}

public class Program {

    // ── current epoch ms (same as UDP node) ───────────
    public static int NowMs() {
        let ns: int = DateTime.NowNanos()
        return ns / 1000000
    }

    // ── UUIDv4 RFC 4122 (lifted from UDP node) ────────
    public static string ByteHex(b: int) {
        let digits: string = "0123456789abcdef"
        let hi: int = (b >> 4) & 15
        let lo: int = b & 15
        return String_CharAt1(digits, hi) + String_CharAt1(digits, lo)
    }

    public static string UuidV4() {
        let bytes: List<int> = Random.SystemBytes(16)
        let b6: int = (bytes.Get(6) & 15) | 64
        let b8: int = (bytes.Get(8) & 63) | 128
        bytes.Set(6, b6)
        bytes.Set(8, b8)
        var out: string = ""
        var i: int = 0
        while (i < 16) {
            if (i == 4 || i == 6 || i == 8 || i == 10) { out = out + "-" }
            out = out + Program.ByteHex(bytes.Get(i))
            i = i + 1
        }
        return out
    }

    // ── envelope builders (unchanged from UDP, kept JSON) ──
    public static string EncodeAck(string messageId, int timestamp) {
        let v = new JsonValue()
        v.SetObject(new List<string>(), new List<JsonValue>())
        v.AppendEntry("type",      Json.OfString("ACK"))
        v.AppendEntry("messageId", Json.OfString(messageId))
        v.AppendEntry("timestamp", Json.OfInt(timestamp))
        return Json.Encode(v)
    }

    // Phase 4.5.1 — build the `debug` field JSON that gets
    // attached to publisher envelopes when --debug is set.
    // Shape :  {"session":"<sid>","mode":"step|breakpoint",
    //           "manager":"host:port","breakpoints":["role",…],
    //           "hit_bp":false}
    // `bpCsv` is the raw comma-separated --debug-bp list ; empty
    // = no breakpoints (only meaningful for mode="breakpoint").
    public static string BuildDebugJson(string mode, string session,
                                         string manager, string bpCsv) {
        var bps: string = "[]"
        if (String_Length(bpCsv) > 0) {
            let parts: List<string> = String_Split(bpCsv, ",")
            var inner: string = ""
            let n: int = parts.Count()
            for i in 0..n {
                let p: string = parts.Get(i)
                if (String_Length(p) == 0) { continue }
                if (String_Length(inner) > 0) { inner = inner + "," }
                inner = inner + "{\"role\":\"" + Json.EscapeString(p) + "\"}"
            }
            bps = "[" + inner + "]"
        }
        return "{\"session\":\"" + Json.EscapeString(session) + "\"," +
               "\"mode\":\"" + Json.EscapeString(mode) + "\"," +
               "\"manager\":\"" + Json.EscapeString(manager) + "\"," +
               "\"breakpoints\":" + bps + "," +
               "\"hit_bp\":false}"
    }

    public static string EncodeMessage(string topicUuid, int topicVersion,
                                       string dataJson, string messageId,
                                       int timestamp, string debugJson) {
        let mid: string = Json.EscapeString(messageId)
        let tu:  string = Json.EscapeString(topicUuid)
        let tv:  string = String_FromInt(topicVersion)
        let ts:  string = String_FromInt(timestamp)
        var dbg: string = ""
        if (String_Length(debugJson) > 0) {
            dbg = ",\"debug\":" + debugJson
        }
        // Phase 5.3 — rootMessageId is propagated through every
        // forward hop so persistent state files can key by the
        // execution's first-hop mid. At root insertion the value
        // equals the local mid ; downstream hops preserve it via
        // _pollen_wf_rebuild_envelope.
        return "{\"messageId\":\"" + mid +
               "\",\"rootMessageId\":\"" + mid +
               "\",\"type\":\"MESSAGE\"," +
               "\"topic\":{\"uuid\":\"" + tu +
               "\",\"version\":" + tv + "}," +
               "\"data\":" + dataJson + "," +
               "\"timestamp\":" + ts + dbg + "}"
    }

    // ── Phase 3.3: workflow.json loader (factored out of Main) ──
    //
    // Re-runnable by the watcher thread when the file mtime
    // changes. Wraps the read-parse-resolve sequence + the C-side
    // reload_begin/reload_commit so the hot path sees an atomic
    // swap of consumes / nexts / emit topic. Returns true on
    // successful load (whether or not a role was found), false if
    // the file is missing / unparseable.
    // ── Phase 5.0 — workflow.json schema v2 compat ──
    //
    // v1 (the shipped form) :
    //   { "nodes": { "<role>": {host, port, consumes, emits, next}, … } }
    //
    // v2 (workflow-tree proposal) :
    //   { "schema": "workflow-tree/v1",
    //     "nodes":  [ {id, label?, host, port, consumes, emits, next}, … ],
    //     "vars":   { … } }
    //
    // The internal representation stays the same in 5.0 — the v2
    // `tree` field is ignored (Phase 5.1 will wire it). Adapter
    // helpers normalize node lookup + iteration over both shapes.

    // Detect v2 via the `schema` top-level field.
    public static bool IsWorkflowV2(JsonValue root) {
        let sV: JsonValue = root.Get("schema")
        if (!sV.IsString()) { return false }
        let s: string = sV.AsString()
        return String_StartsWith(s, "workflow-tree/")
    }

    // Find a node by its key (role in v1 ; id or label in v2).
    // Returns a JsonValue ; check IsObject() on the caller side
    // to detect "not found".
    public static JsonValue FindNodeByKey(JsonValue nodesV, string key) {
        if (nodesV.IsObject()) {
            return nodesV.Get(key)
        }
        if (nodesV.IsArray()) {
            let items: List<JsonValue> = nodesV.AsArray()
            let n: int = items.Count()
            for i in 0..n {
                let it: JsonValue = items.Get(i)
                if (it.Get("id").AsString() == key)    { return it }
                if (it.Get("label").AsString() == key) { return it }
            }
        }
        return nodesV.Get("__pollen_missing_sentinel__")
    }

    // List the iteration keys for the nodes container. For v1 = the
    // object keys ; for v2 = the label (preferred) or id of each entry.
    public static List<string> NodeKeys(JsonValue nodesV) {
        if (nodesV.IsObject()) { return nodesV.Keys() }
        let out: List<string> = new List<string>()
        if (nodesV.IsArray()) {
            let items: List<JsonValue> = nodesV.AsArray()
            let n: int = items.Count()
            for i in 0..n {
                let it: JsonValue = items.Get(i)
                let lbl: string = it.Get("label").AsString()
                if (String_Length(lbl) > 0) { out.Add(lbl); continue }
                let id: string = it.Get("id").AsString()
                if (String_Length(id) > 0) { out.Add(id) }
            }
        }
        return out
    }

    // ── Phase 5.1 — workflow.json `tree` walker ──
    //
    // When the v2 schema includes a `tree` field, routing is
    // driven by the tree instead of per-node `next` arrays. For
    // this first slab we support :
    //
    //   {"type":"call",     "node":"<role>"}
    //   {"type":"fan_out",  "nodes":["<role>", …]}
    //   {"type":"sequence", "steps":[<Action>, <Action>, …]}
    //   {"type":"end"}
    //
    // Semantics map to the v1 flat-DAG behaviour (per-node next):
    // when role X is called at sequence step i, X's outgoing edges
    // are the targets of sequence step i+1 (the "what comes next").
    // If no next step, X is terminal. Phase 5.2 will add nested
    // `if` ; Phase 5.4 will add `while` + `for` with the full
    // treePath walker.

    // Does this Action name `role` as a call target or fan_out target?
    public static bool StepNames(JsonValue actionV, string role) {
        if (!actionV.IsObject()) { return false }
        let kind: string = actionV.Get("type").AsString()
        if (kind == "call") {
            return actionV.Get("node").AsString() == role
        }
        if (kind == "fan_out") {
            let nodesV: JsonValue = actionV.Get("nodes")
            if (!nodesV.IsArray()) { return false }
            let nodes: List<JsonValue> = nodesV.AsArray()
            let n: int = nodes.Count()
            for i in 0..n {
                if (nodes.Get(i).AsString() == role) { return true }
            }
        }
        return false
    }

    // The list of node names this Action would dispatch to. For
    // call → [node]. For fan_out → nodes[]. For end / sequence →
    // empty (sequence is itself a list, not a dispatcher).
    public static List<string> ActionTargets(JsonValue actionV) {
        let out: List<string> = new List<string>()
        if (!actionV.IsObject()) { return out }
        let kind: string = actionV.Get("type").AsString()
        if (kind == "call") {
            let nV: string = actionV.Get("node").AsString()
            if (String_Length(nV) > 0) { out.Add(nV) }
            return out
        }
        if (kind == "fan_out") {
            let nodesV: JsonValue = actionV.Get("nodes")
            if (!nodesV.IsArray()) { return out }
            let nodes: List<JsonValue> = nodesV.AsArray()
            let n: int = nodes.Count()
            for i in 0..n {
                let s: string = nodes.Get(i).AsString()
                if (String_Length(s) > 0) { out.Add(s) }
            }
            return out
        }
        // Phase 5.4.2 — recurse into nested constructs to find the
        // first dispatchable target. Used when an if-branch's
        // `then` is a sub-sequence : we want the role at the top
        // of that sequence as the actual fan-out destination.
        if (kind == "sequence") {
            let stepsV: JsonValue = actionV.Get("steps")
            if (!stepsV.IsArray()) { return out }
            let steps: List<JsonValue> = stepsV.AsArray()
            let sn: int = steps.Count()
            for i in 0..sn {
                let s: JsonValue = steps.Get(i)
                if (!s.IsObject()) { continue }
                let st: string = s.Get("type").AsString()
                if (st == "set") { continue }
                // First non-set step : recurse to extract its targets.
                return Program.ActionTargets(s)
            }
        }
        return out
    }

    // Find the raw Action object (call / fan_out / if / end / …)
    // that immediately follows `role`'s step in the top-level
    // sequence. Returns an empty JsonValue if role is terminal or
    // not found. Phase 5.2 uses this to distinguish flat fan_out
    // (handled by ActionTargets + _pollen_wf_add_next) from `if`
    // (handled by _pollen_cond_branch_open_s + add_target).
    public static JsonValue FindActionRawAfter(JsonValue treeV, string role) {
        let empty: JsonValue = new JsonValue()
        if (!treeV.IsObject()) { return empty }
        let kind: string = treeV.Get("type").AsString()
        if (kind == "sequence") {
            let stepsV: JsonValue = treeV.Get("steps")
            if (!stepsV.IsArray()) { return empty }
            let steps: List<JsonValue> = stepsV.AsArray()
            let n: int = steps.Count()
            for i in 0..n {
                let step: JsonValue = steps.Get(i)
                if (Program.StepNames(step, role)) {
                    if (i + 1 < n) { return steps.Get(i + 1) }
                    return empty
                }
            }
        }
        return empty
    }

    // Phase 5.4.2 — recursive walker. Returns the sequence-steps
    // list that directly contains `role`'s step, whether the role
    // lives in the top-level sequence or nested inside an `if`
    // branch / `for` body. A 1-step "synthetic" sequence is returned
    // when role is named by a single leaf action (e.g. an `if`
    // branch whose `then` is just a `call(role)` with no surrounding
    // sequence) — that role is terminal within its branch but
    // still gets a consistent shape for downstream helpers.
    //
    // Note : if role appears in multiple places, the first match in
    // pre-order is returned. Same-role-in-multiple-branches with
    // different post-actions is genuinely ambiguous at runtime (the
    // role doesn't know which branch it came from), so we just pick
    // the first.
    public static List<JsonValue> FindRoleSequence(JsonValue action, string role) {
        let empty: List<JsonValue> = new List<JsonValue>()
        if (!action.IsObject()) { return empty }
        let kind: string = action.Get("type").AsString()

        if (kind == "sequence") {
            let stepsV: JsonValue = action.Get("steps")
            if (!stepsV.IsArray()) { return empty }
            let steps: List<JsonValue> = stepsV.AsArray()
            let n: int = steps.Count()
            // 1. Role directly named at this level → return THIS seq.
            for i in 0..n {
                if (Program.StepNames(steps.Get(i), role)) {
                    return steps
                }
            }
            // 2. Recurse into nested constructs.
            for i in 0..n {
                let nested: List<JsonValue> = Program.FindRoleSequence(steps.Get(i), role)
                if (nested.Count() > 0) { return nested }
            }
            return empty
        }

        if (kind == "if") {
            let branchesV: JsonValue = action.Get("branches")
            if (!branchesV.IsArray()) { return empty }
            let branches: List<JsonValue> = branchesV.AsArray()
            let bn: int = branches.Count()
            for bi in 0..bn {
                let br: JsonValue = branches.Get(bi)
                if (!br.IsObject()) { continue }
                let thenV: JsonValue = br.Get("then")
                if (!thenV.IsObject()) { continue }
                let nested: List<JsonValue> = Program.FindRoleSequence(thenV, role)
                if (nested.Count() > 0) { return nested }
            }
            return empty
        }

        if (kind == "for") {
            let doV: JsonValue = action.Get("do")
            if (doV.IsObject()) {
                return Program.FindRoleSequence(doV, role)
            }
            return empty
        }

        // Leaf : call / fan_out / set / end / while.
        // (while doesn't carry a body of its own — self-loop only.)
        if (Program.StepNames(action, role)) {
            let one: List<JsonValue> = new List<JsonValue>()
            one.Add(action)
            return one
        }
        return empty
    }

    // Same as before but operates on the sequence containing role,
    // wherever in the tree it lives.
    public static List<JsonValue> CollectSetsAfter(JsonValue treeV, string role) {
        let out: List<JsonValue> = new List<JsonValue>()
        let steps: List<JsonValue> = Program.FindRoleSequence(treeV, role)
        let n: int = steps.Count()
        if (n == 0) { return out }
        var found: int = -1
        for i in 0..n {
            if (Program.StepNames(steps.Get(i), role)) { found = i; break }
        }
        if (found < 0) { return out }
        var j: int = found + 1
        while (j < n) {
            let step: JsonValue = steps.Get(j)
            if (!step.IsObject()) { break }
            if (step.Get("type").AsString() != "set") { break }
            out.Add(step)
            j = j + 1
        }
        return out
    }

    // Phase 5.4 — for `while`, return the step that immediately
    // follows the while dispatcher in the containing sequence.
    public static JsonValue FindStepAfterDispatcher(JsonValue treeV, string role) {
        let empty: JsonValue = new JsonValue()
        let steps: List<JsonValue> = Program.FindRoleSequence(treeV, role)
        let n: int = steps.Count()
        if (n == 0) { return empty }
        var found: int = -1
        for i in 0..n {
            if (Program.StepNames(steps.Get(i), role)) { found = i; break }
        }
        if (found < 0) { return empty }
        var j: int = found + 1
        while (j < n) {
            let s: JsonValue = steps.Get(j)
            if (!s.IsObject()) { return empty }
            if (s.Get("type").AsString() != "set") { break }
            j = j + 1
        }
        if (j + 1 < n) { return steps.Get(j + 1) }
        return empty
    }

    // Return the first non-`set` action after role's step.
    public static JsonValue FindDispatcherAfter(JsonValue treeV, string role) {
        let empty: JsonValue = new JsonValue()
        let steps: List<JsonValue> = Program.FindRoleSequence(treeV, role)
        let n: int = steps.Count()
        if (n == 0) { return empty }
        var found: int = -1
        for i in 0..n {
            if (Program.StepNames(steps.Get(i), role)) { found = i; break }
        }
        if (found < 0) { return empty }
        var j: int = found + 1
        while (j < n) {
            let step: JsonValue = steps.Get(j)
            if (!step.IsObject()) { return empty }
            if (step.Get("type").AsString() != "set") { return step }
            j = j + 1
        }
        return empty
    }

    // Find the "next" targets after `role` in the tree. Walks one
    // level of sequence — Phase 5.4 will extend for nested
    // structures + while/for loops.
    public static List<string> FindActionAfter(JsonValue treeV, string role) {
        let out: List<string> = new List<string>()
        if (!treeV.IsObject()) { return out }
        let kind: string = treeV.Get("type").AsString()
        // Top-level sequence : iterate steps, find the one that
        // names role, return the targets of the next step.
        if (kind == "sequence") {
            let stepsV: JsonValue = treeV.Get("steps")
            if (!stepsV.IsArray()) { return out }
            let steps: List<JsonValue> = stepsV.AsArray()
            let n: int = steps.Count()
            for i in 0..n {
                let step: JsonValue = steps.Get(i)
                if (Program.StepNames(step, role)) {
                    if (i + 1 < n) {
                        return Program.ActionTargets(steps.Get(i + 1))
                    }
                    return out  // terminal — role is the last step
                }
            }
            return out
        }
        // Top-level single call/fan_out : role gets no next, since
        // there's nothing after.
        if (Program.StepNames(treeV, role)) { return out }
        return out
    }

    public static bool LoadWorkflow(string workflowPath, string nodeName, int actualPort) {
        if (!File_Exists(workflowPath)) {
            Console.WriteLine("workflow: file not found: {workflowPath}")
            return false
        }
        let body: string = File_ReadAll(workflowPath)
        let parser: JsonParser = new JsonParser(body)
        let root: JsonValue    = parser.ParseTopLevel()
        if (parser.HasFailed()) {
            let emsg: string = parser.ErrorMsg()
            Console.WriteLine("workflow: parse failed: {emsg}")
            return false
        }
        let wfNameV: JsonValue = root.Get("name")
        let wfVerV:  JsonValue = root.Get("version")
        let wfName:  string = wfNameV.AsString()
        let wfVer:   int    = wfVerV.AsInt()
        let nodesV: JsonValue = root.Get("nodes")
        let isV2: bool = Program.IsWorkflowV2(root)
        // v1 → object ; v2 → array. Either is fine.
        let nodesOk: bool = nodesV.IsObject() || nodesV.IsArray()
        if (!nodesOk) {
            Console.WriteLine("workflow: 'nodes' missing or not an object/array")
            return false
        }
        // Find role (--node-name override beats port lookup).
        var role: string = nodeName
        if (String_Length(role) == 0) {
            let nodeKeys: List<string> = Program.NodeKeys(nodesV)
            let nk: int = nodeKeys.Count()
            for ki in 0..nk {
                let key: string = nodeKeys.Get(ki)
                let entry: JsonValue = Program.FindNodeByKey(nodesV, key)
                let pV: JsonValue = entry.Get("port")
                let p: int = pV.AsInt()
                if (p == actualPort) {
                    role = key
                    break
                }
            }
        }
        @c { _pollen_wf_reload_begin(); }
        if (String_Length(role) == 0) {
            @c { _pollen_wf_reload_commit(); }
            Console.WriteLine("workflow: no role matches port :{actualPort}; running in free-form mode")
            return true
        }
        let me: JsonValue = Program.FindNodeByKey(nodesV, role)
        if (!me.IsObject()) {
            @c { _pollen_wf_reload_commit(); }
            Console.WriteLine("workflow: role '{role}' not in nodes")
            return true
        }
        let conV: JsonValue = me.Get("consumes")
        let emiV: JsonValue = me.Get("emits")
        let nxtV: JsonValue = me.Get("next")
        let conS: string = Program.JoinArr(conV)
        let emiS: string = Program.JoinArr(emiV)
        let nxtS: string = Program.JoinArr(nxtV)
        if (conV.IsArray()) {
            let conItems: List<JsonValue> = conV.AsArray()
            let cn: int = conItems.Count()
            for ci in 0..cn {
                let cit: JsonValue = conItems.Get(ci)
                let topic: string = cit.AsString()
                @c { _pollen_wf_add_consume(topic); }
            }
        }
        if (emiV.IsArray()) {
            let emiItems: List<JsonValue> = emiV.AsArray()
            if (emiItems.Count() > 0) {
                let etV: JsonValue = emiItems.Get(0)
                let et: string = etV.AsString()
                @c { _pollen_wf_set_emit_topic(et); }
            }
        }
        // Phase 5.1 — if the workflow has a `tree`, derive next[]
        // from it. Otherwise fall back to the node's own `next`
        // array (v1 + v2-without-tree behaviour).
        let treeV: JsonValue = root.Get("tree")
        let hasTree: bool = treeV.IsObject()
        var nxtSrcTag: string = "node.next"
        var nxtSReal: string = nxtS
        if (hasTree) {
            nxtSrcTag = "tree"
            // Phase 5.3 — walk past any `set` steps first, registering
            // each as a pending state mutation. The next dispatcher
            // (call/fan_out/if) is what determines actual routing.
            let setSteps: List<JsonValue> = Program.CollectSetsAfter(treeV, role)
            let sCount: int = setSteps.Count()
            for si in 0..sCount {
                let setStep: JsonValue = setSteps.Get(si)
                let pathV: JsonValue = setStep.Get("path")
                let valueV: JsonValue = setStep.Get("value")
                let p: string = pathV.AsString()
                // Phase 5.3.1 — pass the raw value expression to the
                // C evaluator. Supports {"const":…}, {"var":"…"},
                // {"op":"+|-|*|/","left":…,"right":…} and any nesting.
                // A bare literal (number, string, true/false/null) is
                // wrapped as {"const":<lit>} so the evaluator's
                // single entrypoint can handle it.
                var expr: string = ""
                if (valueV.IsObject()) {
                    expr = Json.Encode(valueV)
                } else {
                    expr = "{\"const\":" + Json.Encode(valueV) + "}"
                }
                if (String_Length(p) > 0) {
                    @c { _pollen_set_ops_add(p, expr); }
                }
            }
            let nextAction: JsonValue = Program.FindDispatcherAfter(treeV, role)
            var nextKind: string = ""
            if (nextAction.IsObject()) {
                nextKind = nextAction.Get("type").AsString()
            }
            if (nextKind == "for") {
                nxtSrcTag = "tree.for"
                let varV: JsonValue   = nextAction.Get("var")
                let inV:  JsonValue   = nextAction.Get("in")
                let doV:  JsonValue   = nextAction.Get("do")
                let itemVar: string = varV.AsString()
                if (String_Length(itemVar) == 0) { itemVar = "item" }
                @c { _pollen_for_setup(itemVar); }
                // Phase 5.4.3 — iterate every dispatchable target of
                // do (call → 1, fan_out → N, sequence → first non-set
                // step's targets via ActionTargets recursion).
                var targetSummary: string = ""
                if (doV.IsObject()) {
                    let targets: List<string> = Program.ActionTargets(doV)
                    let tn: int = targets.Count()
                    for ti in 0..tn {
                        let tRole: string = targets.Get(ti)
                        let tNode: JsonValue = Program.FindNodeByKey(nodesV, tRole)
                        if (tNode.IsObject()) {
                            let th: string = tNode.Get("host").AsString()
                            let tp: int    = tNode.Get("port").AsInt()
                            @c { _pollen_for_add_target(th, (int) tp); }
                            if (String_Length(targetSummary) > 0) { targetSummary = targetSummary + "," }
                            targetSummary = targetSummary + tRole
                        }
                    }
                }
                var inner: string = "for(" + itemVar + ")→[" + targetSummary + "]"
                if (inV.IsArray()) {
                    let items: List<JsonValue> = inV.AsArray()
                    let ic: int = items.Count()
                    for ii in 0..ic {
                        let it: JsonValue = items.Get(ii)
                        let itLit: string = Json.Encode(it)
                        @c { _pollen_for_add_item(itLit); }
                    }
                    inner = inner + "×" + String_FromInt(ic)
                }
                nxtSReal = inner
            } else if (nextKind == "while") {
                nxtSrcTag = "tree.while"
                let condV: JsonValue   = nextAction.Get("cond")
                let maxV:  JsonValue   = nextAction.Get("maxIter")
                // Phase 5.4.1 — cond passed as raw JSON, evaluated
                // recursively (composite and/or/not + leaves).
                var condJson: string = ""
                if (condV.IsObject()) {
                    condJson = Json.Encode(condV)
                }
                var maxIter: int = 100
                if (maxV.IsInt()) { maxIter = maxV.AsInt() }
                let selfHost: string = me.Get("host").AsString()
                let selfPort: int    = actualPort
                let iterKey: string = "_wf_iter_" + role
                @c { _pollen_while_setup_expr(condJson, iterKey, (int) maxIter,
                                                selfHost, (int) selfPort); }
                let exitAction: JsonValue = Program.FindStepAfterDispatcher(treeV, role)
                var inner: string = "while(cond)→self+exits"
                if (exitAction.IsObject()) {
                    let exitTargets: List<string> = Program.ActionTargets(exitAction)
                    let ec: int = exitTargets.Count()
                    for ei in 0..ec {
                        let er: string = exitTargets.Get(ei)
                        let en: JsonValue = Program.FindNodeByKey(nodesV, er)
                        if (en.IsObject()) {
                            let eh: string = en.Get("host").AsString()
                            let ep: int    = en.Get("port").AsInt()
                            @c { _pollen_while_add_exit(eh, (int) ep); }
                        }
                    }
                    inner = inner + " exits=" + String_FromInt(ec)
                }
                nxtSReal = inner
            } else if (nextKind == "if") {
                nxtSrcTag = "tree.if"
                let branchesV: JsonValue = nextAction.Get("branches")
                if (branchesV.IsArray()) {
                    let branches: List<JsonValue> = branchesV.AsArray()
                    let bn: int = branches.Count()
                    var inner: string = ""
                    for bi in 0..bn {
                        let br: JsonValue = branches.Get(bi)
                        if (!br.IsObject()) { continue }
                        let thenV: JsonValue = br.Get("then")
                        // Phase 5.4.1 — accept two forms :
                        //   a) {"cond": <CondExpr>, "then": …}
                        //      where CondExpr can be composite
                        //      (and/or/not) or a leaf {"op":…,"var":…,"value":…}
                        //   b) Legacy flat : {"op":…,"var":…,"value":…,"then":…}
                        //      treated as a leaf cond.
                        // Else branch : neither — empty cond.
                        var condJson: string = ""
                        let condV: JsonValue = br.Get("cond")
                        if (condV.IsObject()) {
                            condJson = Json.Encode(condV)
                        } else {
                            let opV: JsonValue = br.Get("op")
                            let opS: string = opV.AsString()
                            if (String_Length(opS) > 0) {
                                // Re-encode legacy leaf form as a
                                // canonical Cond JSON so the C eval
                                // only has one shape to deal with.
                                let varEnc: string = Json.Encode(br.Get("var"))
                                let valEnc: string = Json.Encode(br.Get("value"))
                                condJson = "{\"op\":\"" + opS + "\",\"var\":" + varEnc + ",\"value\":" + valEnc + "}"
                            }
                        }
                        @c { _pollen_cond_branch_open_expr(condJson); }
                        // Resolve `then` targets to (host, port) and
                        // register against this branch slot.
                        let thenTargets: List<string> = Program.ActionTargets(thenV)
                        let tcount: int = thenTargets.Count()
                        for ti in 0..tcount {
                            let nextRole: string = thenTargets.Get(ti)
                            if (String_Length(inner) > 0) { inner = inner + "," }
                            inner = inner + nextRole
                            let nextNode: JsonValue = Program.FindNodeByKey(nodesV, nextRole)
                            if (nextNode.IsObject()) {
                                let nhV: JsonValue = nextNode.Get("host")
                                let npV: JsonValue = nextNode.Get("port")
                                let nh: string = nhV.AsString()
                                let np: int    = npV.AsInt()
                                @c { _pollen_cond_branch_add_target(nh, (int) np); }
                            }
                        }
                    }
                    nxtSReal = inner
                }
            } else {
            // Phase 5.3 — dispatch from the post-set dispatcher rather
            // than the raw next step ; this lets a sequence like
            // [call(x), set(...), set(...), fan_out(y,z)] still route
            // x → [y, z].
            let treeTargets: List<string> = Program.ActionTargets(nextAction)
            let tn: int = treeTargets.Count()
            var inner: string = ""
            for ti in 0..tn {
                let nextRole: string = treeTargets.Get(ti)
                if (String_Length(inner) > 0) { inner = inner + "," }
                inner = inner + nextRole
                let nextNode: JsonValue = Program.FindNodeByKey(nodesV, nextRole)
                if (nextNode.IsObject()) {
                    let nhV: JsonValue = nextNode.Get("host")
                    let npV: JsonValue = nextNode.Get("port")
                    let nh: string = nhV.AsString()
                    let np: int    = npV.AsInt()
                    @c { _pollen_wf_add_next(nh, (int) np); }
                }
            }
            nxtSReal = inner
            }
        } else if (nxtV.IsArray()) {
            let nxtItems: List<JsonValue> = nxtV.AsArray()
            let xn: int = nxtItems.Count()
            for xi in 0..xn {
                let xit: JsonValue = nxtItems.Get(xi)
                let nextRole: string = xit.AsString()
                let nextNode: JsonValue = Program.FindNodeByKey(nodesV, nextRole)
                if (nextNode.IsObject()) {
                    let nhV: JsonValue = nextNode.Get("host")
                    let npV: JsonValue = nextNode.Get("port")
                    let nh: string = nhV.AsString()
                    let np: int    = npV.AsInt()
                    @c { _pollen_wf_add_next(nh, (int) np); }
                }
            }
        }
        @c { _pollen_wf_reload_commit(); }
        var schemaTag: string = "v1"
        if (isV2) { schemaTag = "v2" }
        Console.WriteLine("workflow: loaded '{wfName}' v{wfVer} ({schemaTag}) role={role} consumes=[{conS}] emits=[{emiS}] next=[{nxtSReal}] (next from {nxtSrcTag})")
        Console.Flush()
        return true
    }

    // Comma-join the strings of a JSON array. Returns "" if the
    // value isn't an array (so a missing 'consumes' / 'emits' /
    // 'next' field renders as empty brackets rather than crashing).
    public static string JoinArr(JsonValue v) {
        if (!v.IsArray()) { return "" }
        let items: List<JsonValue> = v.AsArray()
        let n: int = items.Count()
        var out: string = ""
        for i in 0..n {
            let it: JsonValue = items.Get(i)
            let s: string = it.AsString()
            if (i == 0) {
                out = s
            } else {
                out = out + "," + s
            }
        }
        return out
    }

    public static string TopicSummary(JsonValue topic) {
        if (!topic.IsObject()) { return "?" }
        let uuidV:    JsonValue = topic.Get("uuid")
        let versionV: JsonValue = topic.Get("version")
        let uuid:    string = uuidV.AsString()
        let version: int    = versionV.AsInt()
        var shortId: string = uuid
        if (String_Length(uuid) >= 8) {
            shortId = String_Substring(uuid, 0, 8)
        }
        return shortId + " v" + String_FromInt(version)
    }

    // ── publish stream: one TCP connection, many MESSAGE→ACK pairs
    //
    // Opens a single TCP conn to peerIp:peerPort, fires N publishes
    // back-to-back (each MSG\n then read ACK\n) on the same socket.
    // Closes when done. ackBuf carries partial bytes between recv
    // chunks (TCP doesn't preserve message boundaries; a single
    // recv() may return part of one ACK, a full ACK, or several
    // ACKs concatenated).
    //
    // Returns the count of MESSAGEs whose ACK matched. Mismatched
    // ACKs are logged but don't abort the stream — caller can
    // decide whether the partial success counts.

    public static int PublishStream(string peerIp, int peerPort,
                                     string topicUuid, int topicVersion,
                                     string dataJson, int count,
                                     string debugJson) {
        let cli = TcpClient_Connect(peerIp, peerPort)
        if (!cli.Connected) {
            Console.WriteLine("publish-stream FAILED to {peerIp}:{peerPort} (connect refused)")
            Console.Flush()
            return 0
        }
        var ackBuf: string = ""
        var done: int = 0
        var idx: int = 0
        while (idx < count) {
            let mid:  string = Program.UuidV4()
            let now:  int    = Program.NowMs()
            let body: string = Program.EncodeMessage(topicUuid, topicVersion,
                                                      dataJson, mid, now, debugJson)
            // amc resolver bug: TcpClient_Send declared void but C
            // returns code_bool — can't capture. Rely on the recv
            // path to surface broken sockets.
            TcpClient_Send(cli, body + "\n")
            Console.WriteLine("publish {mid} to {peerIp}:{peerPort} topic={topicUuid} v{topicVersion} ts={now}")
            // Read until we have a full line in ackBuf.
            var nlPos: int = String_IndexOf(ackBuf, "\n")
            while (nlPos < 0) {
                let chunk: string = TcpClient_Receive(cli, 4096)
                if (chunk == null) {
                    Console.WriteLine("publish-stream EOF mid-ACK at idx={idx}")
                    Console.Flush()
                    TcpClient_Close(cli)
                    return done
                }
                ackBuf = ackBuf + chunk
                nlPos = String_IndexOf(ackBuf, "\n")
            }
            let line: string = String_Substring(ackBuf, 0, nlPos)
            let rest: int    = String_Length(ackBuf) - nlPos - 1
            ackBuf = String_Substring(ackBuf, nlPos + 1, rest)
            let parser: JsonParser = new JsonParser(line)
            let v: JsonValue       = parser.ParseTopLevel()
            if (parser.HasFailed()) {
                Console.WriteLine("publish FAILED {mid} (ACK JSON parse: {parser.ErrorMsg()})")
            } else {
                let tV: JsonValue = v.Get("type")
                let mV: JsonValue = v.Get("messageId")
                let tS: string = tV.AsString()
                let mS: string = mV.AsString()
                let ackNow: int = Program.NowMs()
                if (tS == "ACK" && mS == mid) {
                    Console.WriteLine("recv ACK from {peerIp}:{peerPort} for {mid} (publish complete) ts={ackNow}")
                    done = done + 1
                } else {
                    Console.WriteLine("publish FAILED {mid} (ACK mismatch: type={tS} mid={mS})")
                }
            }
            Console.Flush()
            idx = idx + 1
        }
        TcpClient_Close(cli)
        return done
    }

    // Server-side connection handling is inlined in Main's accept
    // loop because amc currently mis-namespaces the built-in
    // AmalgameTcpConn struct when it appears in an AM function
    // signature (same family as the AmalgameUdpSocket quirk). Same
    // workaround pattern as the UDP node.

    public static void Main(string[] args) {
        var port:        int    = 5000
        var publishSpec: string = ""
        // --burst <ip:port:topic:ver:data:count> — bench fast path
        // that bypasses the AM-side O(M) semicolon parse and calls
        // pollen_hot_publish_stream once for the whole batch.
        var burstSpec:   string = ""
        // --workflow <path> + --node-name <role> — Phase 3.0
        // workflow.json self-identification. The node reads the
        // JSON, finds its role (by --node-name override or by
        // matching host:port), and logs consume/emit/next lists.
        // Runtime dispatch (consume filtering + auto-emit) is
        // deferred to Phase 3.1+; the hot path stays unchanged.
        var workflowPath: string = ""
        var nodeName:     string = ""
        // --shared-dir <path> — Phase 3.5 persistent execution
        // records. When set, each MESSAGE traversal at this node
        // writes <path>/executions/<mid>.json.
        var sharedDir:    string = ""
        // Phase 4.5.1 debug stepper — when --debug is "step" or
        // "breakpoint", outbound MESSAGES via --publish or --burst
        // get a `debug` field in the envelope :
        //   {"session":"<uuid>","mode":"step|breakpoint",
        //    "manager":"<host:port>","breakpoints":["role",…],
        //    "hit_bp":false}
        // The hot path on receiving nodes ignores it in 4.5.1 — only
        // _pollen_wf_rebuild_envelope propagates the field hop-to-hop
        // (preserved verbatim). Pause behaviour lands in 4.5.2.
        var debugMode:    string = ""
        var debugSession: string = ""
        var debugManager: string = ""
        var debugBps:     string = ""

        var i: int = 1
        while (i < Args_Count()) {
            let a: string = Args_Get(i)
            if (a == "--publish") {
                if (i + 1 < Args_Count()) {
                    if (String_Length(publishSpec) > 0) {
                        publishSpec = publishSpec + ";" + Args_Get(i + 1)
                    } else {
                        publishSpec = Args_Get(i + 1)
                    }
                    i = i + 2
                    continue
                }
                Console.WriteLine("pollen-node-tcp: --publish needs ip:port:uuid:ver:data")
                return
            }
            if (a == "--burst") {
                if (i + 1 < Args_Count()) {
                    burstSpec = Args_Get(i + 1)
                    i = i + 2
                    continue
                }
                Console.WriteLine("pollen-node-tcp: --burst needs ip:port:uuid:ver:data:count")
                return
            }
            if (a == "--workflow") {
                if (i + 1 < Args_Count()) {
                    workflowPath = Args_Get(i + 1)
                    i = i + 2
                    continue
                }
                Console.WriteLine("pollen-node-tcp: --workflow needs a file path")
                return
            }
            if (a == "--node-name") {
                if (i + 1 < Args_Count()) {
                    nodeName = Args_Get(i + 1)
                    i = i + 2
                    continue
                }
                Console.WriteLine("pollen-node-tcp: --node-name needs a role name")
                return
            }
            if (a == "--shared-dir") {
                if (i + 1 < Args_Count()) {
                    sharedDir = Args_Get(i + 1)
                    i = i + 2
                    continue
                }
                Console.WriteLine("pollen-node-tcp: --shared-dir needs a directory path")
                return
            }
            if (a == "--debug") {
                if (i + 1 < Args_Count() && !String_StartsWith(Args_Get(i + 1), "--")) {
                    debugMode = Args_Get(i + 1)
                    i = i + 2
                    continue
                }
                Console.WriteLine("pollen-node-tcp: --debug needs step|breakpoint")
                return
            }
            if (a == "--debug-session") {
                if (i + 1 < Args_Count() && !String_StartsWith(Args_Get(i + 1), "--")) {
                    debugSession = Args_Get(i + 1)
                    i = i + 2
                    continue
                }
                Console.WriteLine("pollen-node-tcp: --debug-session needs a non-empty value (got next flag instead — maybe $(uuidgen) returned empty?)")
                return
            }
            if (a == "--debug-manager") {
                if (i + 1 < Args_Count() && !String_StartsWith(Args_Get(i + 1), "--")) {
                    debugManager = Args_Get(i + 1)
                    i = i + 2
                    continue
                }
                Console.WriteLine("pollen-node-tcp: --debug-manager needs a host:port")
                return
            }
            if (a == "--debug-bp") {
                if (i + 1 < Args_Count() && !String_StartsWith(Args_Get(i + 1), "--")) {
                    debugBps = Args_Get(i + 1)
                    i = i + 2
                    continue
                }
                Console.WriteLine("pollen-node-tcp: --debug-bp needs a comma-separated role list")
                return
            }
            if (port == 5000) {
                port = String_ToInt(a)
            }
            i = i + 1
        }

        let server = TcpServer_Listen(port, 128)
        if (!server.Listening) {
            Console.WriteLine("pollen-node-tcp: failed to listen on TCP :{port}")
            return
        }
        let actualPort: int = server.Port
        if (port == 0) {
            // TcpServer.Port reflects the requested port (0 here);
            // the kernel-assigned ephemeral port lives on the
            // underlying fd. The current Amalgame.Net builtin
            // doesn't expose it via the struct, so we log what we
            // know and warn callers using ephemeral binds that
            // they need to read getsockname themselves (Phase 2.x
            // will add Tcp.LocalPort the same way UdpSocket got
            // it in amc v0.8.52).
            Console.WriteLine("pollen-node-tcp: listening on TCP (ephemeral — port discovery deferred)")
        } else {
            Console.WriteLine("pollen-node-tcp: listening on TCP :{actualPort}")
        }
        Console.WriteLine("pollen-node-tcp: wire = JSON\\n-delim, transport = long-lived TCP (v0.2.0-dev Phase 2.1)")
        Console.Flush()

        // ── Phase 3.5: configure shared-dir + self identity ──
        // The C-side recorder needs role + host:port to stamp each
        // step file. Role here is the CLI --node-name (resolved to
        // the workflow's actual key inside LoadWorkflow if needed,
        // but for the recorder the operator-supplied name is the
        // right human label). Host defaults to 127.0.0.1 — Phase 3.x
        // will read the workflow.json host for this role.
        if (String_Length(sharedDir) > 0) {
            @c { _pollen_shared_dir_set(sharedDir); }
            Console.WriteLine("pollen-node-tcp: sharedDir = {sharedDir} (executions/ recorder armed)")
            Console.Flush()
        }
        let selfRole: string = nodeName
        let selfHost: string = "127.0.0.1"
        @c { _pollen_self_set(selfRole, selfHost, (int) actualPort); }

        // ── Phase 3.0: workflow.json self-identification ──
        //   Phase 3.3 hot-reload: after the initial load, spawn a
        //   watcher thread that polls workflow.json's mtime and
        //   re-runs LoadWorkflow whenever the file changes.
        if (String_Length(workflowPath) > 0) {
            Program.LoadWorkflow(workflowPath, nodeName, actualPort)
            // Watcher closure — captures workflowPath, nodeName,
            // actualPort, polls File_Mtime every 2 seconds, calls
            // LoadWorkflow on change. The C side handles the
            // atomic swap; AM just orchestrates the I/O.
            let wfPath:   string = workflowPath
            let wfRole:   string = nodeName
            let wfPort:   int    = actualPort
            var lastMt:   int    = File_Mtime(wfPath)
            let watcher = (arg: int) => {
                while (true) {
                    Threading.ThreadSleep(2000)
                    if (!File_Exists(wfPath)) { continue }
                    let mt: int = File_Mtime(wfPath)
                    if (mt != lastMt) {
                        Console.WriteLine("workflow: detected change (mtime {lastMt} → {mt}), reloading")
                        Program.LoadWorkflow(wfPath, wfRole, wfPort)
                        lastMt = mt
                    }
                }
            }
            Threading.ThreadSpawn(watcher, 0)
            Console.WriteLine("workflow: watcher armed on {workflowPath} (poll 2 s)")
            Console.Flush()
        }
        if (false) {   // dead-code anchor — the original inline parse
                       // block below this point is unreachable but
                       // left in place so a future edit can grep
                       // diff cleanly. Phase 3.x will delete it.
            if (true) {
                let body: string = File_ReadAll(workflowPath)
                let parser: JsonParser = new JsonParser(body)
                let root: JsonValue    = parser.ParseTopLevel()
                if (parser.HasFailed()) {
                    let emsg: string = parser.ErrorMsg()
                    Console.WriteLine("workflow: parse failed: {emsg}")
                } else {
                    let wfNameV: JsonValue = root.Get("name")
                    let wfVerV:  JsonValue = root.Get("version")
                    let wfName:  string = wfNameV.AsString()
                    let wfVer:   int    = wfVerV.AsInt()
                    Console.WriteLine("workflow: loaded '{wfName}' v{wfVer} from {workflowPath}")
                    let nodesV: JsonValue = root.Get("nodes")
                    if (!nodesV.IsObject()) {
                        Console.WriteLine("workflow: 'nodes' missing or not an object")
                    } else {
                        // Determine our role: --node-name override
                        // beats host:port matching. Host matching on
                        // loopback / single-host setups isn't
                        // useful (every role has same host), so
                        // --node-name is the recommended path for
                        // smoke tests.
                        var role: string = nodeName
                        if (String_Length(role) == 0) {
                            let nodeKeys: List<string> = nodesV.Keys()
                            let nk: int = nodeKeys.Count()
                            for ki in 0..nk {
                                let key: string = nodeKeys.Get(ki)
                                let entry: JsonValue = nodesV.Get(key)
                                let hV: JsonValue = entry.Get("host")
                                let pV: JsonValue = entry.Get("port")
                                let h: string = hV.AsString()
                                let p: int    = pV.AsInt()
                                if (p == actualPort) {
                                    // Best-effort: any host with the
                                    // right port wins on loopback.
                                    // Production: match actual hostname.
                                    role = key
                                    break
                                }
                            }
                        }
                        if (String_Length(role) == 0) {
                            Console.WriteLine("workflow: no role matches port :{actualPort}; running in free-form mode")
                        } else {
                            let me: JsonValue = nodesV.Get(role)
                            if (!me.IsObject()) {
                                Console.WriteLine("workflow: role '{role}' not in nodes")
                            } else {
                                let conV: JsonValue = me.Get("consumes")
                                let emiV: JsonValue = me.Get("emits")
                                let nxtV: JsonValue = me.Get("next")
                                let conS: string = Program.JoinArr(conV)
                                let emiS: string = Program.JoinArr(emiV)
                                let nxtS: string = Program.JoinArr(nxtV)
                                Console.WriteLine("workflow: role={role}  consumes=[{conS}]  emits=[{emiS}]  next=[{nxtS}]")

                                // ── Phase 3.1: register consumes ──
                                if (conV.IsArray()) {
                                    let conItems: List<JsonValue> = conV.AsArray()
                                    let cn: int = conItems.Count()
                                    for ci in 0..cn {
                                        let cit: JsonValue = conItems.Get(ci)
                                        let topic: string = cit.AsString()
                                        @c { _pollen_wf_add_consume(topic); }
                                    }
                                }

                                // ── Phase 3.2: register emit topic ──
                                // First entry of `emits` is the topic
                                // this node re-emits on (typical
                                // workflow transformer pattern: consume
                                // x.raw, emit x.cooked).
                                if (emiV.IsArray()) {
                                    let emiItems: List<JsonValue> = emiV.AsArray()
                                    if (emiItems.Count() > 0) {
                                        let etV: JsonValue = emiItems.Get(0)
                                        let et: string = etV.AsString()
                                        @c { _pollen_wf_set_emit_topic(et); }
                                    }
                                }

                                // ── Phase 3.2: resolve next roles → host:port pairs ──
                                if (nxtV.IsArray()) {
                                    let nxtItems: List<JsonValue> = nxtV.AsArray()
                                    let xn: int = nxtItems.Count()
                                    for xi in 0..xn {
                                        let xit: JsonValue = nxtItems.Get(xi)
                                        let nextRole: string = xit.AsString()
                                        let nextNode: JsonValue = nodesV.Get(nextRole)
                                        if (nextNode.IsObject()) {
                                            let nhV: JsonValue = nextNode.Get("host")
                                            let npV: JsonValue = nextNode.Get("port")
                                            let nh: string = nhV.AsString()
                                            let np: int    = npV.AsInt()
                                            @c { _pollen_wf_add_next(nh, (int) np); }
                                            Console.WriteLine("workflow: route → {nextRole} at {nh}:{np}")
                                        } else {
                                            Console.WriteLine("workflow: warning — next '{nextRole}' not in nodes table")
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Console.Flush()
        }

        // ── --burst fast path (Phase 2.4e) ────────────────
        // Single split on ':' (5 fields + count), one call into the
        // C hot path. Sidesteps the AM-side O(M) semicolon parsing
        // that bottlenecked --publish at M ≥ 200.
        if (String_Length(burstSpec) > 0) {
            let parts: List<string> = String_Split(burstSpec, ":")
            if (parts.Count() < 6) {
                Console.WriteLine("pollen-node-tcp: --burst needs ip:port:uuid:ver:data:count")
            } else {
                let bIp:    string = parts.Get(0)
                let bPort:  int    = String_ToInt(parts.Get(1))
                let bUuid:  string = parts.Get(2)
                let bVer:   int    = String_ToInt(parts.Get(3))
                // Data field may itself contain colons (JSON braces).
                // Rejoin everything between idx 4 and the last part
                // (which is the count).
                var bData:  string = parts.Get(4)
                var bj: int = 5
                while (bj < parts.Count() - 1) {
                    bData = bData + ":" + parts.Get(bj)
                    bj = bj + 1
                }
                let bCount: int = String_ToInt(parts.Get(parts.Count() - 1))
                @c {
                    pollen_hot_publish_stream(
                        bIp, bPort, bUuid, bVer, bData, bCount);
                }
            }
        }

        // Phase 4.5.1 — validate + default the debug flags.
        // --debug requires a session (auto-generated if empty) and
        // a manager address (no default, must be supplied).
        if (String_Length(debugMode) > 0) {
            if (debugMode != "step" && debugMode != "breakpoint") {
                Console.WriteLine("pollen-node-tcp: --debug must be 'step' or 'breakpoint' (got '{debugMode}')")
                return
            }
            if (String_Length(debugSession) == 0) {
                debugSession = Program.UuidV4()
                Console.WriteLine("pollen-node-tcp: --debug-session auto-generated = {debugSession}")
            }
            if (String_Length(debugManager) == 0) {
                Console.WriteLine("pollen-node-tcp: --debug requires --debug-manager <host:port>")
                return
            }
        }

        // Startup-time publishes. All specs that target the same
        // ip:port stream over a single TCP connection — TCP handshake
        // is paid once per peer, not once per MESSAGE.
        if (String_Length(publishSpec) > 0) {
            let specs: List<string> = String_Split(publishSpec, ";")
            let m: int = specs.Count()
            // First pass: parse all specs into parallel lists, group
            // by peer in a single pass (good enough for small spec
            // counts; the bench uses one peer per publisher).
            let ips:   List<string> = new List<string>()
            let ports: List<int>    = new List<int>()
            let uuids: List<string> = new List<string>()
            let vers:  List<int>    = new List<int>()
            let datas: List<string> = new List<string>()
            for si in 0..m {
                let spec: string = specs.Get(si)
                if (String_Length(spec) == 0) { continue }
                let parts: List<string> = String_Split(spec, ":")
                if (parts.Count() < 5) {
                    Console.WriteLine("pollen-node-tcp: --publish spec needs ip:port:uuid:ver:data ({spec})")
                    continue
                }
                let pIp:   string = parts.Get(0)
                let pPort: int    = String_ToInt(parts.Get(1))
                let pUuid: string = parts.Get(2)
                let pVer:  int    = String_ToInt(parts.Get(3))
                var pData: string = parts.Get(4)
                var pj: int = 5
                while (pj < parts.Count()) {
                    pData = pData + ":" + parts.Get(pj)
                    pj = pj + 1
                }
                ips.Add(pIp); ports.Add(pPort)
                uuids.Add(pUuid); vers.Add(pVer); datas.Add(pData)
            }
            // Second pass: open a conn for each distinct peer, stream
            // every MSG that targets it. The bench typically has all
            // K=N specs hit the same receiver so we open 1 conn and
            // fire M MSGs — the natural HTTP/1.1 keep-alive pattern.
            let n: int = ips.Count()
            var i: int = 0
            while (i < n) {
                let pIp: string = ips.Get(i)
                let pPort: int  = ports.Get(i)
                // collect indices for this peer
                let group: List<int> = new List<int>()
                var j: int = i
                while (j < n) {
                    if (ips.Get(j) == pIp && ports.Get(j) == pPort) {
                        group.Add(j)
                    }
                    j = j + 1
                }
                // Phase 2.4b — pipelined stream. Two passes on the
                // same conn:
                //   1. Blast every MSG in the group back-to-back
                //      (TCP's send buffer + Nagle handle batching).
                //      Stash each (mid, sendTs) for the latency
                //      match below.
                //   2. Drain N ACKs from the line-buffer, parse,
                //      log "publish complete" with the publish-side
                //      ts (so bench latency math stays correct).
                //
                // Net effect: K serial round-trips collapse into one
                // "send-burst → recv-burst" cycle per peer, bounded
                // by per-msg server cost (~150 µs) rather than
                // round-trip wall (~28 µs minimum × M).
                // ── Phase 2.4d: hot-path publisher in @c{} ──
                //
                // The whole AM pipeline-send + drain-ACK loop above
                // is replaced by a single C function call. Per-iter
                // AM allocations (UUID gen, JSON encode, List.Add,
                // Console.WriteLine) are eliminated — UUIDs come
                // from getrandom + inline hex format, envelope is
                // snprintf'd into a stack buffer, ACK matching is
                // pointer-walk on the recv buffer. fprintf still
                // emits the bench-compatible 'publish <mid>' and
                // 'recv ACK ...' lines so the latency parser keeps
                // working unchanged.
                //
                // Limitation: assumes the whole group shares one
                // (topicUuid, version, data) tuple. The bench
                // satisfies this. For mixed groups we'd loop and
                // call once per uniform slice.
                let gn: int = group.Count()
                if (gn > 0) {
                    let firstIdx: int = group.Get(0)
                    let gTopic: string = uuids.Get(firstIdx)
                    let gVer:   int    = vers.Get(firstIdx)
                    let firstData: string = datas.Get(firstIdx)
                    // Phase 4.5.1 — when --debug is set the publish
                    // envelope needs a `debug` JSON object, which
                    // the C hot-path snprintf doesn't know how to
                    // build. Dispatch to the AM PublishStream
                    // (slower, ~10× the cost) only in that case.
                    // Debug sessions are by definition human-paced
                    // → the perf delta is irrelevant.
                    if (String_Length(debugMode) > 0) {
                        let dj: string = Program.BuildDebugJson(
                            debugMode, debugSession, debugManager, debugBps)
                        // --publish data is a raw positional string ;
                        // wrap it as a JSON string so the envelope is
                        // valid for the Manager UI to parse. Bench
                        // path (no --debug) keeps the raw splice for
                        // perf.
                        let dataQuoted: string = "\"" + Json.EscapeString(firstData) + "\""
                        Program.PublishStream(pIp, pPort, gTopic, gVer,
                                              dataQuoted, gn, dj)
                    } else {
                        // Pass first data verbatim. Per-iter variance
                        // costs an AM substring-search at startup that
                        // ate the C hot-path gain — drop it. Every
                        // msg in this group has the same data; only
                        // messageId varies. Bench dedups on messageId,
                        // not data, so this stays correct.
                        @c {
                            pollen_hot_publish_stream(
                                pIp, pPort, gTopic, gVer, firstData, gn);
                        }
                    }
                }
                // Advance i past all entries in this group
                i = i + 1
                while (i < n && ips.Get(i) == pIp && ports.Get(i) == pPort) {
                    i = i + 1
                }
            }
        }

        // Server accept loop with one worker thread per connection
        // (Phase 2.2). The closure body owns the conn it captured
        // and runs the full long-lived recv loop on it — main thread
        // races back to accept(). K concurrent peers handled in
        // parallel without serialising on the accept().
        while (true) {
            let conn = TcpServer_Accept(server)
            if (!conn.Connected) {
                continue
            }
            // Extract the raw socket fd via @c{} while we still have
            // a valid AmalgameTcpConn* type in scope. Inside the
            // closure body the conn pointer would collapse to i64
            // (amc closure-capture quirk) and `conn->_fd` would no
            // longer parse — so we grab it here as a plain int and
            // let the closure capture that primitive.
            // Extract the raw socket fd via @c{} while we still have
            // the AmalgameTcpConn* in scope, then pass it through
            // the thread arg slot (i64). amc closure capture doesn't
            // see vars set via @c{} (no static analysis on raw C),
            // so going through the thread arg sidesteps the issue.
            var fdLocal: int = 0
            @c { fdLocal = conn->_fd; }
            let handler = (arg: int) => {
                // Hot path: ~14 µs / MSG→ACK on this VM vs ~150 µs
                // for the AM equivalent. SYNCHRONIZATION & log
                // surface go away in this loop — every line gets
                // ACK'd. Re-enable the AM path if a richer dispatch
                // is needed (the Program.EncodeAck / topic summary
                // code above is still compiled in for that case).
                @c { pollen_hot_conn_loop((int) arg); }
                TcpConn_Close(conn)
            }
            Threading.ThreadSpawn(handler, fdLocal)
        }
    }
}
