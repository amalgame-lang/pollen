// Pollen — UDP node daemon (Phase 1.5b: + publish API w/ retry)
//
// Wire-compatible with TARMeule v1: parses + emits JSON envelopes:
//
//   MESSAGE   { "messageId": "...", "type": "MESSAGE",
//               "topic": { "uuid": "...", "version": N },
//               "data": <any>, "timestamp": <epoch ms> }
//   ACK       { "type": "ACK", "messageId": "...", "timestamp": N }
//   SYNC      { "type": "SYNCHRONIZATION", "entityType": "topic"|"souscription",
//               "uuid": "...", "timestamp": N }
//
// On receive of a MESSAGE the node:
//   1. parses the envelope
//   2. dedups by messageId (7.5 s window — same as TARMeule)
//   3. ACKs the sender immediately (even on duplicate — that's by
//      design; the peer's retry stops only when it sees the ACK)
//   4. prints a one-line summary on stdout for visibility
//
// ACK and SYNCHRONIZATION receives are parsed but not yet wired —
// Phase 1.4 hooks ACK into the pendingMessages retry loop, Phase 1.5
// makes SYNC reload topics/souscriptions from sharedDir.
//
// Usage:
//   pollen-node 5000                     # bind 0.0.0.0:5000
//   pollen-node 0                        # ephemeral (port is printed)
//   pollen-node 5000 --shared ./data     # load + reload topics from
//                                        # ./data/topics/<uuid>.json
//                                        # and souscriptions/<uuid>.json
//
// The ReceiveFrom timeout is 200 ms so the retry / dedup GC sweep
// can interleave without latency cost.

namespace Pollen.Node

import Amalgame.Net
import Amalgame.Formats.Json
import Amalgame.DateTime
import Amalgame.Random
import Amalgame.Collections
import Amalgame.String

// ── Dedup cache entry ─────────────────────────────────
//
// Drops a duplicate MESSAGE before dispatch but still ACKs it back
// — that's how the peer's retry loop learns to stop. Cleanup runs
// on every receive (cheap with a short window).

public class DedupEntry {
    public MessageId: string
    public ExpiresAt: int       // epoch ms when this id can be evicted

    public DedupEntry(string id, int expires) {
        this.MessageId = id
        this.ExpiresAt = expires
    }
}

// ── Outbound pending-ACK entry (Phase 1.5b) ───────────
//
// One per MESSAGE we've sent and are still waiting for an ACK on.
// Re-sent every ackTimeoutMs until either a matching ACK arrives
// (removed via PendingRemove) or maxAttempts is reached (emits a
// 'publish timeout' log + removed).

public class PendingMessage {
    public MessageId: string
    public PeerIp:    string
    public PeerPort:  int
    public Body:      string    // pre-encoded JSON envelope, reused on retry
    public SentAtMs:  int       // when the LAST attempt fired
    public Attempts:  int       // 1 = initial send; retries grow this

    public PendingMessage(string id, string ip, int port, string body, int sentAt) {
        this.MessageId = id
        this.PeerIp    = ip
        this.PeerPort  = port
        this.Body      = body
        this.SentAtMs  = sentAt
        this.Attempts  = 1
    }
}

public class Program {

    // Retry constants. Conservative defaults for LAN; expose via
    // CLI in a later phase. Window = ackTimeout × maxAttempts × 1.5
    // gives the dedup cache enough room to swallow a retry burst.
    public static int AckTimeoutMs() { return 1000 }
    public static int MaxAttempts()  { return 5 }   // initial send + 4 retries
    public static int DedupWindowMs() { return 7500 }

    // ── UUIDv4 (RFC 4122) ─────────────────────────────
    //
    // Same construction as pollen-client: 16 bytes of OS entropy
    // via amalgame-random, version (4) in byte 6, variant (10xx)
    // in byte 8. TARMeule-compatible.

    public static string ByteHex(b: int) {
        let digits: string = "0123456789abcdef"
        let hi: int = (b >> 4) & 15
        let lo: int = b & 15
        return String_CharAt1(digits, hi) + String_CharAt1(digits, lo)
    }

    public static string UuidV4() {
        let bytes: List<int> = Random.SystemBytes(16)
        let b6: int = (bytes.Get(6) & 15) | 64
        let b8: int = (bytes.Get(8) & 63) | 128
        bytes.Set(6, b6)
        bytes.Set(8, b8)
        var out: string = ""
        var i: int = 0
        while (i < 16) {
            if (i == 4 || i == 6 || i == 8 || i == 10) { out = out + "-" }
            out = out + Program.ByteHex(bytes.Get(i))
            i = i + 1
        }
        return out
    }

    // ── current epoch ms ──────────────────────────────
    //
    // amalgame-datetime's DateTime.NowNanos() wraps the platform's
    // clock_gettime(CLOCK_REALTIME) / GetSystemTimeAsFileTime —
    // ~100 ns each. Earlier iterations shelled out to `date +%s%3N`
    // (fork+exec per timestamp = 1-3 ms each, blew up the receive
    // loop budget once we added Phase 1.4 retries).
    public static int NowMs() {
        let ns: int = DateTime.NowNanos()
        return ns / 1000000
    }

    // ── dedup cache helpers ───────────────────────────

    public static bool DedupSeen(List<DedupEntry> cache, string id) {
        let n: int = cache.Count()
        for i in 0..n {
            let e: DedupEntry = cache.Get(i)
            if (e.MessageId == id) { return true }
        }
        return false
    }

    public static void DedupAdd(List<DedupEntry> cache, string id, int now) {
        cache.Add(new DedupEntry(id, now + Program.DedupWindowMs()))
    }

    // Evict entries older than now. Single linear pass; cheap when
    // the cache stays under a few hundred entries.
    public static void DedupGC(List<DedupEntry> cache, int now) {
        var i: int = 0
        while (i < cache.Count()) {
            let e: DedupEntry = cache.Get(i)
            if (e.ExpiresAt <= now) {
                cache.RemoveAt(i)
            } else {
                i = i + 1
            }
        }
    }

    // ── ACK envelope ──────────────────────────────────
    //
    // Build `{ "type":"ACK", "messageId":"<id>", "timestamp": N }`
    // as a freshly-encoded JSON string. Same shape as TARMeule.

    public static string EncodeAck(string messageId, int timestamp) {
        let v = new JsonValue()
        v.SetObject(new List<string>(), new List<JsonValue>())
        v.AppendEntry("type",      Json.OfString("ACK"))
        v.AppendEntry("messageId", Json.OfString(messageId))
        v.AppendEntry("timestamp", Json.OfInt(timestamp))
        return Json.Encode(v)
    }

    // ── MESSAGE envelope ──────────────────────────────
    //
    // Hand-built string so the caller's `dataJson` bytes flow
    // through verbatim (a JsonValue round-trip would canonicalise
    // and reorder keys). Same pattern as pollen-client.

    public static string EncodeMessage(string topicUuid, int topicVersion,
                                       string dataJson, string messageId,
                                       int timestamp) {
        let mid: string = Json.EscapeString(messageId)
        let tu:  string = Json.EscapeString(topicUuid)
        let tv:  string = String_FromInt(topicVersion)
        let ts:  string = String_FromInt(timestamp)
        return "{\"messageId\":\"" + mid +
               "\",\"type\":\"MESSAGE\"," +
               "\"topic\":{\"uuid\":\"" + tu +
               "\",\"version\":" + tv + "}," +
               "\"data\":" + dataJson + "," +
               "\"timestamp\":" + ts + "}"
    }

    // ── Outbound pending-ACK machinery ────────────────
    //
    // Publish() / ProcessPending() would naturally live here as
    // static helpers, but amc's cgen currently mis-namespaces the
    // built-in C struct `AmalgameUdpSocket` when it appears in an
    // AM function signature (treats it as a Pollen.Node-local
    // class). The logic is inlined in Main instead — short enough
    // that the DRY loss is fine, and will refactor once amc fixes
    // the resolver quirk.

    // Remove the matching messageId from pending on incoming ACK.
    // Returns true if a match was found (caller can log). This one
    // doesn't need the socket so it stays a Program method.
    public static bool PendingRemove(List<PendingMessage> pending, string messageId) {
        let n: int = pending.Count()
        for i in 0..n {
            let p: PendingMessage = pending.Get(i)
            if (p.MessageId == messageId) {
                pending.RemoveAt(i)
                return true
            }
        }
        return false
    }

    // ── topic summary for logs ────────────────────────

    public static string TopicSummary(JsonValue topic) {
        if (!topic.IsObject()) { return "?" }
        // Two-step bind because amc's chained method-call type
        // inference loses the JsonValue type across `.Get(...)`.
        let uuidV:    JsonValue = topic.Get("uuid")
        let versionV: JsonValue = topic.Get("version")
        let uuid:    string = uuidV.AsString()
        let version: int    = versionV.AsInt()
        var shortId: string = uuid
        if (String_Length(uuid) >= 8) {
            shortId = String_Substring(uuid, 0, 8)
        }
        return shortId + " v" + String_FromInt(version)
    }

    // ── main loop ─────────────────────────────────────

    // ── sharedDir helpers (Phase 1.5) ──────────────────
    //
    // Topics and Subscriptions persist as one JSON file per UUID
    // under sharedDir/topics/ and sharedDir/souscriptions/. We
    // don't ship a directory-list builtin yet — `ls -1` via the
    // Process stdlib is the portable path until amc grows one.

    public static int ScanDir(string dir, string label) {
        let cmd: string = "ls -1 \"" + dir + "\" 2>/dev/null | grep '\\.json$' || true"
        let r = Process.RunCapture(cmd)
        let out: string = String_Trim(r.Stdout)
        if (String_Length(out) == 0) {
            Console.WriteLine("pollen-node: sharedDir {label} empty or missing ({dir})")
            return 0
        }
        let entries: List<string> = String_Split(out, "\n")
        let n: int = entries.Count()
        var loaded: int = 0
        for i in 0..n {
            let fname: string = String_Trim(entries.Get(i))
            if (String_Length(fname) == 0) { continue }
            let path: string = dir + "/" + fname
            if (!File_Exists(path)) { continue }
            let body: string = File_ReadAll(path)
            // Parse the file so a malformed entry surfaces early
            // instead of breaking the receive loop later.
            let parser: JsonParser = new JsonParser(body)
            let v: JsonValue       = parser.ParseTopLevel()
            if (parser.HasFailed()) {
                let emsg: string = parser.ErrorMsg()
                Console.WriteLine("pollen-node: {label} parse fail {fname}: {emsg}")
                continue
            }
            let uuidV: JsonValue = v.Get("uuid")
            let uuid:  string    = uuidV.AsString()
            Console.WriteLine("pollen-node: loaded {label} {uuid} from {fname}")
            loaded = loaded + 1
        }
        return loaded
    }

    public static void ReloadEntity(string sharedDir, string entityType, string uuid) {
        // entityType is "topic" or "souscription" (TARMeule plural
        // mapping: 'topic' → 'topics/', 'souscription' → 'souscriptions/').
        var subdir: string = ""
        if (entityType == "topic")        { subdir = "topics" }
        if (entityType == "souscription") { subdir = "souscriptions" }
        if (String_Length(subdir) == 0) {
            Console.WriteLine("pollen-node: SYNC unknown entityType '{entityType}'")
            return
        }
        let path: string = sharedDir + "/" + subdir + "/" + uuid + ".json"
        if (!File_Exists(path)) {
            Console.WriteLine("pollen-node: SYNC reload — file missing: {path}")
            return
        }
        let body: string = File_ReadAll(path)
        let parser: JsonParser = new JsonParser(body)
        let v: JsonValue       = parser.ParseTopLevel()
        if (parser.HasFailed()) {
            let emsg: string = parser.ErrorMsg()
            Console.WriteLine("pollen-node: SYNC reload {path} parse fail: {emsg}")
            return
        }
        Console.WriteLine("pollen-node: SYNC reloaded {entityType} {uuid}")
    }

    public static void Main(string[] args) {
        var port:        int    = 5000
        var sharedDir:   string = ""
        var publishSpec: string = ""

        // Arg parser:
        //   [port] [--shared <dir>] [--publish ip:port:uuid:ver:data] *
        // Multiple --publish flags can be passed; semicolons inside
        // one --publish split into successive publishes (lets
        // load-test scripts hand a single arg with N specs).
        var i: int = 1
        while (i < Args_Count()) {
            let a: string = Args_Get(i)
            if (a == "--shared") {
                if (i + 1 < Args_Count()) {
                    sharedDir = Args_Get(i + 1)
                    i = i + 2
                    continue
                }
                Console.WriteLine("pollen-node: --shared needs a directory argument")
                return
            }
            if (a == "--publish") {
                if (i + 1 < Args_Count()) {
                    if (String_Length(publishSpec) > 0) {
                        publishSpec = publishSpec + ";" + Args_Get(i + 1)
                    } else {
                        publishSpec = Args_Get(i + 1)
                    }
                    i = i + 2
                    continue
                }
                Console.WriteLine("pollen-node: --publish needs ip:port:uuid:ver:data")
                return
            }
            // First positional = port.
            if (port == 5000) {
                port = String_ToInt(a)
            }
            i = i + 1
        }

        let sock = UdpSocket_New()
        let bound: bool = UdpSocket_Bind(sock, port)
        if (!bound) {
            Console.WriteLine("pollen-node: failed to bind UDP :{port}")
            return
        }
        let actualPort: int = sock.BoundPort
        Console.WriteLine("pollen-node: listening on UDP :{actualPort}")
        Console.WriteLine("pollen-node: JSON wire, dedup window = 7500 ms")

        // Phase 1.5: optional sharedDir scan at startup.
        if (String_Length(sharedDir) > 0) {
            Console.WriteLine("pollen-node: sharedDir = {sharedDir}")
            let nTopics: int = Program.ScanDir(sharedDir + "/topics",         "topic")
            let nSubs:   int = Program.ScanDir(sharedDir + "/souscriptions",  "souscription")
            Console.WriteLine("pollen-node: sharedDir loaded {nTopics} topics, {nSubs} souscriptions")
        }

        // stdout is block-buffered when redirected — flush so
        // supervisors (mosaic-style, systemd, test runners) see the
        // startup line immediately without waiting for the 4 KB
        // buffer to fill or for the process to exit.
        Console.Flush()

        let dedup:   List<DedupEntry>     = new List<DedupEntry>()
        let pending: List<PendingMessage> = new List<PendingMessage>()

        // Phase 1.5b — startup-time publishes. Spec format
        // (semicolon-separated list of):
        //   ip:port:topic-uuid:version:data-json
        // The data-json must be a single JSON value; embed colons
        // freely inside string fields, but be aware that a literal
        // ':' outside a quoted region will split. (Move to a richer
        // format if a user runs into this — for now KISS works.)
        if (String_Length(publishSpec) > 0) {
            let specs: List<string> = String_Split(publishSpec, ";")
            let m: int = specs.Count()
            for si in 0..m {
                let spec: string = specs.Get(si)
                if (String_Length(spec) == 0) { continue }
                let parts: List<string> = String_Split(spec, ":")
                if (parts.Count() < 5) {
                    Console.WriteLine("pollen-node: --publish spec needs ip:port:uuid:ver:data ({spec})")
                    continue
                }
                let pIp:   string = parts.Get(0)
                let pPort: int    = String_ToInt(parts.Get(1))
                let pUuid: string = parts.Get(2)
                let pVer:  int    = String_ToInt(parts.Get(3))
                // Re-join in case the data-json contained ':' chars
                // (we split on every ':'). Skip the first 4 segments.
                var pData: string = parts.Get(4)
                var pj: int = 5
                while (pj < parts.Count()) {
                    pData = pData + ":" + parts.Get(pj)
                    pj = pj + 1
                }
                // Inline of Program.Publish (see comment above the
                // PendingRemove helper for why we don't carry the
                // AmalgameUdpSocket through a function signature).
                let mid:  string = Program.UuidV4()
                let nowP: int    = Program.NowMs()
                let body: string = Program.EncodeMessage(pUuid, pVer, pData, mid, nowP)
                UdpSocket_Send(sock, pIp, pPort, body)
                pending.Add(new PendingMessage(mid, pIp, pPort, body, nowP))
                Console.WriteLine("publish {mid} to {pIp}:{pPort} topic={pUuid} v{pVer}")
            }
            Console.Flush()
        }

        // Receive loop. 200 ms timeout lets the pending-ACK retry
        // sweep interleave without burning CPU.
        while (true) {
            let dg = UdpSocket_ReceiveFrom(sock, 65536, 200)
            let now: int = Program.NowMs()
            Program.DedupGC(dedup, now)

            // Inline pending-ACK retry sweep — see note above the
            // PendingRemove helper for why this isn't a separate
            // static method.
            var pi: int = 0
            var pendingTouched: bool = false
            while (pi < pending.Count()) {
                let pm: PendingMessage = pending.Get(pi)
                let due: int = pm.SentAtMs + Program.AckTimeoutMs()
                if (now < due) { pi = pi + 1; continue }
                if (pm.Attempts >= Program.MaxAttempts()) {
                    Console.WriteLine("publish TIMEOUT {pm.MessageId} to {pm.PeerIp}:{pm.PeerPort} after {pm.Attempts} attempts")
                    pending.RemoveAt(pi)
                    pendingTouched = true
                    continue
                }
                UdpSocket_Send(sock, pm.PeerIp, pm.PeerPort, pm.Body)
                pm.Attempts = pm.Attempts + 1
                pm.SentAtMs = now
                Console.WriteLine("publish retry {pm.MessageId} to {pm.PeerIp}:{pm.PeerPort} (attempt {pm.Attempts})")
                pendingTouched = true
                pi = pi + 1
            }
            // Block-buffered stdout: flush whenever we emitted a
            // log line in the sweep, otherwise supervisors never
            // see retries until the process exits.
            if (pendingTouched) { Console.Flush() }

            if (dg == null) { continue }

            let payload: string = dg.Data
            let fromIp:  string = dg.FromIp
            let fromPort: int   = dg.FromPort

            // Parse envelope. Drop malformed datagrams silently
            // (Phase 1.x will count them via /metrics; v0.1 just
            // prints a warning).
            // Use JsonParser directly. The static `Json.Parse`
            // returns JsonResult which amc's cgen mis-namespaces
            // (Pollen_Node_JsonResult vs Amalgame_Formats_Json_…)
            // — to be fixed in a future amc release. JsonParser's
            // ParseTopLevel() returns a well-known JsonValue so
            // the resolver stays happy.
            let parser: JsonParser = new JsonParser(payload)
            let env: JsonValue     = parser.ParseTopLevel()
            if (parser.HasFailed()) {
                let pmsg: string = parser.ErrorMsg()
                Console.WriteLine("recv {dg.DataLen} bytes from {fromIp}:{fromPort} — JSON parse failed: {pmsg}")
                continue
            }
            if (!env.IsObject()) {
                Console.WriteLine("recv {dg.DataLen} bytes from {fromIp}:{fromPort} — envelope not an object")
                continue
            }

            let typeV: JsonValue = env.Get("type")
            let mtype: string = typeV.AsString()

            if (mtype == "ACK") {
                let midV: JsonValue = env.Get("messageId")
                let mid: string = midV.AsString()
                let matched: bool = Program.PendingRemove(pending, mid)
                if (matched) {
                    Console.WriteLine("recv ACK from {fromIp}:{fromPort} for {mid} (publish complete)")
                } else {
                    Console.WriteLine("recv ACK from {fromIp}:{fromPort} for {mid} (no pending match)")
                }
                Console.Flush()
                continue
            }

            if (mtype == "SYNCHRONIZATION") {
                let etV: JsonValue = env.Get("entityType")
                let euV: JsonValue = env.Get("uuid")
                let et: string = etV.AsString()
                let eu: string = euV.AsString()
                Console.WriteLine("recv SYNC from {fromIp}:{fromPort} {et}={eu}")
                // Phase 1.5: reload the corresponding file from
                // sharedDir if one was configured at startup.
                if (String_Length(sharedDir) > 0) {
                    Program.ReloadEntity(sharedDir, et, eu)
                }
                Console.Flush()
                continue
            }

            if (mtype == "MESSAGE") {
                let midV: JsonValue = env.Get("messageId")
                let mid: string = midV.AsString()
                if (String_Length(mid) == 0) {
                    Console.WriteLine("recv MESSAGE from {fromIp}:{fromPort} — missing messageId, dropping")
                    continue
                }

                let topicV: JsonValue = env.Get("topic")
                let topicSum: string = Program.TopicSummary(topicV)

                // Dedup: ACK either way, dispatch only on first sight.
                let already: bool = Program.DedupSeen(dedup, mid)
                if (already) {
                    Console.WriteLine("recv MESSAGE dup {mid} topic={topicSum} from {fromIp}:{fromPort} — re-ACK only")
                } else {
                    Program.DedupAdd(dedup, mid, now)
                    Console.WriteLine("recv MESSAGE {mid} topic={topicSum} from {fromIp}:{fromPort} bytes={dg.DataLen}")
                    // Phase 1.5+ will dispatch to a per-topic handler here.
                }

                let ackBody: string = Program.EncodeAck(mid, now)
                let sent: bool = UdpSocket_Send(sock, fromIp, fromPort, ackBody)
                if (!sent) {
                    Console.WriteLine("send ACK failed to {fromIp}:{fromPort}")
                }
                Console.Flush()
                continue
            }

            Console.WriteLine("recv unknown type='{mtype}' from {fromIp}:{fromPort} — dropping")
            Console.Flush()
        }
    }
}
