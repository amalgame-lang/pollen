// Pollen — UDP node daemon (Phase 1.2 minimum)
//
// Binds a UDP socket, receives datagrams, echoes them back as ACK
// to the sender. The Phase 1 wire protocol (JSON MESSAGE / ACK /
// SYNC, UUID dedup, ACK retry, topics, subscriptions) lands in
// 1.3 → 1.5. This first iteration just proves the node can talk
// over the new Amalgame.Net surface (UdpSocket.ReceiveFrom +
// ephemeral BoundPort, both shipped in amc v0.8.52).
//
// Usage:
//   pollen-node 5000              # bind 0.0.0.0:5000
//   pollen-node 0                 # ephemeral (port is printed)
//
// The daemon runs until SIGINT (Ctrl-C). For each datagram it
// prints `recv N bytes from IP:PORT: <payload>` and sends back
// `ACK <payload>` to the same IP:PORT. select() inside ReceiveFrom
// uses a 1 s timeout so the loop wakes regularly — later phases
// will use the wake to drive pending-ACK retries and the dedup
// cache GC.

namespace Pollen.Node

import Amalgame.Net

public class Program {
    public static void Main(string[] args) {
        var port: int = 5000
        // Args_Get(0) is the binary path; the first user arg is at 1.
        if (Args_Count() >= 2) {
            port = String_ToInt(Args_Get(1))
        }

        let sock = UdpSocket_New()
        let bound: bool = UdpSocket_Bind(sock, port)
        if (!bound) {
            Console.WriteLine("pollen-node: failed to bind UDP :{port}")
            return
        }
        let actualPort: int = sock.BoundPort
        Console.WriteLine("pollen-node: listening on UDP :{actualPort}")

        // Receive loop — 1 s timeout per iteration so a future
        // ACK-retry / dedup-cleanup pass can interleave cheaply.
        while (true) {
            let dg = UdpSocket_ReceiveFrom(sock, 65536, 1000)
            if (dg == null) {
                continue
            }
            let n: int     = dg.DataLen
            let ip: string = dg.FromIp
            let p: int     = dg.FromPort
            let payload: string = dg.Data
            Console.WriteLine("recv {n} bytes from {ip}:{p}: {payload}")

            let ackBody: string = "ACK " + payload
            let sent: bool = UdpSocket_Send(sock, ip, p, ackBody)
            if (!sent) {
                Console.WriteLine("send ACK failed to {ip}:{p}")
            }
        }
    }
}
